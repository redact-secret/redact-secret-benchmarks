      "baseRate": {
        "kind": "declared-assumption",
        "totalMass": 10000,
        "sensitiveMass": 200,
        "nonSensitiveMass": 1500,
        "notEstablishedMass": 8300,
        "rationale": "Operational text dominated by phone-shaped references, reserved 555 controls and unlisted or ambiguous labels, with a small declared sensitive share."
      }
    }
  ],
