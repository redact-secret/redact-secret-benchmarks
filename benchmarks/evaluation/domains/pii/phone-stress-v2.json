    "file": "docs/contracts/pii/phone-v1.md"
  },
  "referenceValidator": {
    "id": "nanp-structure",
    "version": 1
  },
  "id": "pii-c3-phone-stress-v2",
  "constructionPolicy": {
    "positive": "nanp-n9x-sha256-v1: SHA-256 of the case seed picks an N9X area code (NANPA reserves every N9X NPA for future expansion, so no subscriber holds one), a central-office code NXX without N11 or 555, and a line number. Allocation is never inferred by the product; the reserved NPA only keeps the fixture free of real subscribers.",
    "reserved": "NANPA 555-0100 through 555-0199 as the whole normalized exchange plus line are authority-reserved non-sensitive controls; 555-0099 and 555-0200 are their candidate twins with no negative authority.",
    "exclusions": "Actual N11 area and central-office codes are structural exclusions; they are one-component overrides of a generated value.",
    "unsupported": "Country codes other than +1 (+82, +44 Ofcom drama range), dot displays, x/# markers, line-broken, repeated or seven-digit extensions are authored as not-established identities with no finding; nothing about allocation or other plans is inferred.",
    "context": "Sensitivity follows phone-v1 and pii-context/v1 only: en phone / phone number / telephone / telephone number, ko 전화번호 / 휴대전화번호, and the natural-language contact details; contact / 연락처 are ambiguous, example / documentation / 예시 are occurrence exclusions, other labels have no authority."
  },
  "nonGoals": [
    "local seven-digit NXX-XXXX forms (medium-confidence semantics are not an oracle identity)",
    "any country code other than +1",
    "number allocation, carrier or subscriber inference",
    "product identity-only observation (core #910)"
  ],
  "populations": [
    {
      "id": "diagnostic-balanced",
      "caseCount": 18,
      "baseRate": {
        "kind": "declared-assumption",
        "totalMass": 10000,
        "sensitiveMass": 4000,
        "nonSensitiveMass": 2000,
        "notEstablishedMass": 4000,
        "rationale": "Balanced diagnosis of displays, extensions, reserved controls and context."
      }
    },
    {
      "id": "benign-heavy-stress",
