    },
    "performance-workload": {
      "accuracy": "reuse",
      "performance": "identity-decides"
    },
    "measurement-code": {
      "accuracy": "reuse",
      "performance": "identity-decides"
    },
    "evidence-record": {
      "accuracy": "reuse",
      "performance": "reuse"
    },
    "view-docs": {
      "accuracy": "reuse",
      "performance": "reuse"
    },
    "execution-tooling": {
      "accuracy": "reuse",
      "performance": "reuse"
    }
