  "axes": {
    "direct-slot": {
      "tests": "the value sits in the evidence-established slot in its plainest layout",
      "cases": 73
    },
    "delimiter-after": {
      "tests": "the byte right after the value (quote, ampersand, comma, brace, space, semicolon, CRLF, end of input) decides the span end",
      "cases": 121
    },
    "delimiter-before": {
      "tests": "the byte right before the value (quote, equals, space, colon, tab) decides the span start",
      "cases": 32
    },
    "neighbouring-public-field": {
      "tests": "a public lookalike (id, expiry, type, scope) next to the secret must stay outside the span",
      "cases": 39
    },
    "same-shape-neighbour": {
      "tests": "a public value with the same alphabet and length as the secret sits next to it: shape alone must not decide",
      "cases": 14
    },
    "neighbouring-secret": {
      "tests": "a second credential in the same document does not shift the first span",
      "cases": 17
    },
    "repeat-secret": {
      "tests": "the same value appears twice in one document: both occurrences are the sensitive span",
      "cases": 11
    },
    "utf8-preceding": {
      "tests": "multi-byte text (emoji, CJK, combining marks) before the slot: byte vs UTF-16 vs code point offsets",
      "cases": 15
    },
    "utf8-following": {
      "tests": "multi-byte text right after the value or delimiter",
      "cases": 15
    },
    "end-of-input": {
      "tests": "the value is the last bytes of the input, with no terminator (finalize path)",
      "cases": 32
    },
    "line-ending": {
      "tests": "CRLF, tabs, indentation and trailing whitespace around the slot",
      "cases": 21
    },
    "nesting": {
      "tests": "the slot is inside a nested JSON array/object, YAML list or URL with other parameters",
      "cases": 116
    },
    "big-preceding": {
      "tests": "a few KB of unrelated text before the slot",
      "cases": 9
    },
    "glued-name": {
      "tests": "a name lookalike glued to the slot name (suffix) that must stay a control, or a prefixed name observed as unsupported",
      "cases": 15
    },
    "near-miss-value": {
      "tests": "the name is right but the value is a placeholder, reference, mask, empty, null or too short",
      "cases": 344
    },
    "near-miss-name": {
      "tests": "the value is secret-shaped but the name or header is not the slot",
      "cases": 26
    },
    "alphabet": {
      "tests": "Bearer values using the whole RFC 6750 b64token alphabet and padding",
      "cases": 13
    },
    "value-entropy": {
      "tests": "a low-entropy literal in the slot: medium confidence and warn",
      "cases": 7
    },
    "representation": {
      "tests": "a variant the handoff or the contract leaves unassertable (percent forms, quote styles, case, ambiguous layouts): observed only",
      "cases": 131
    },
    "stream-cut": {
      "tests": "tiny chunk boundaries (7-byte and 1-byte runs): a cut inside the name, between name and value, inside the value and at the delimiter",
      "cases": 9
    },
    "jwt-overlap": {
      "tests": "a JWT-shaped value under Bearer: one final finding, exact JWT",
      "cases": 3
    },
    "value-shape-agnostic": {
      "tests": "the Case admits the value by its slot, whatever its shape: short, long, marker-style and punctuated values all sit in the span",
      "cases": 64
    },
    "endpoint-context": {
      "tests": "the Case attributes the value by the request it sits in; the same carrier in another request is policy-limited and observed",
      "cases": 7
    },
    "multi-span": {
      "tests": "two members of one document are both spans (api_key and encoded)",
      "cases": 15
    },
    "prefix-shape": {
      "tests": "a vendor-prefix shape the evidence leaves open, assembled at run time: observed only",
      "cases": 10
    },
    "role-ambiguity": {
      "tests": "the slot is shared by several roles or the carrier is unresolved in the evidence: observed only",
      "cases": 128
    },
    "policy-limited": {
      "tests": "confidentiality is unstated or the value is public by design in the evidence: observed only",
      "cases": 74
    },
    "derived-value": {
      "tests": "a value derived from a secret (signature, proof, HMAC, JWT) whose confidentiality the evidence does not state: observed only",
      "cases": 13
    },
    "class-extension": {
      "tests": "a non-value variant (bullet mask, {{ secrets.* }} template) that extends the Case's own categories to a sibling form; the Case does not list this exact form",
      "cases": 62
    },
    "contradiction": {
      "tests": "a Case fixture the Group D author recorded as contradicting its contract: observed only",
      "cases": 8
    }
  },
  "scorer": {
    "file": "benchmarks/batch2/score-r2.mjs",
    "sha256": "18b4de8612c8efe75b93785591a309ec8ddf666658463d0dad8d7f7df76fe424",
    "baseScorer": "benchmarks/batch2/score.mjs",
