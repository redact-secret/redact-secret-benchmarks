  "axes": {
    "direct-slot": {
      "tests": "the value sits in the evidence-established slot in its plainest layout",
      "cases": 203
    },
    "delimiter-after": {
      "tests": "the byte right after the value (quote, ampersand, comma, brace, space, semicolon, CRLF, end of input) decides the span end",
      "cases": 132
    },
    "delimiter-before": {
      "tests": "the byte right before the value (quote, equals, space, colon, tab) decides the span start",
      "cases": 26
    },
    "neighbouring-public-field": {
      "tests": "a public lookalike (id, expiry, type, scope) next to the secret must stay outside the span",
      "cases": 40
    },
    "same-shape-neighbour": {
      "tests": "a public value with the same alphabet and length as the secret sits next to it: shape alone must not decide",
      "cases": 26
    },
    "neighbouring-secret": {
      "tests": "a second credential in the same document does not shift the first span",
      "cases": 12
    },
    "repeat-secret": {
      "tests": "the same value appears twice in one document: both occurrences are the sensitive span",
      "cases": 14
    },
    "utf8-preceding": {
      "tests": "multi-byte text (emoji, CJK, combining marks) before the slot: byte vs UTF-16 vs code point offsets",
      "cases": 20
    },
    "utf8-following": {
      "tests": "multi-byte text right after the value or delimiter",
      "cases": 15
    },
    "end-of-input": {
      "tests": "the value is the last bytes of the input, with no terminator (finalize path)",
      "cases": 28
    },
    "line-ending": {
      "tests": "CRLF, tabs, indentation and trailing whitespace around the slot",
      "cases": 28
    },
    "nesting": {
      "tests": "the slot is inside a nested JSON array/object, YAML list or URL with other parameters",
      "cases": 38
    },
    "big-preceding": {
      "tests": "a few KB of unrelated text before the slot",
      "cases": 13
    },
    "glued-name": {
      "tests": "a prefixed or suffixed name lookalike of the slot name: observed only, no Case asserts it",
      "cases": 18
    },
    "near-miss-value": {
      "tests": "the name is right but the value is a placeholder, reference, mask, empty, null or too short",
      "cases": 142
    },
    "near-miss-name": {
      "tests": "the name or header is not the slot the Case names, or a value has no carrier: observed only, no Case asserts it",
      "cases": 81
    },
    "alphabet": {
      "tests": "Bearer values using the whole RFC 6750 b64token alphabet and padding",
      "cases": 3
    },
    "representation": {
      "tests": "a variant the handoff or the contract leaves unassertable (percent forms, quote styles, case, ambiguous layouts): observed only",
      "cases": 81
    },
    "stream-cut": {
      "tests": "tiny chunk boundaries (7-byte and 1-byte runs): a cut inside the name, between name and value, inside the value and at the delimiter",
      "cases": 14
    },
    "era-words": {
      "tests": "the document says the credential is retired, legacy or deprecated: an era never justifies silence in these Cases",
      "cases": 22
    },
    "shape-independence": {
      "tests": "the same slot with a value of a different alphabet and width: the Case flags by position, never by shape",
      "cases": 71
    },
    "fixture-mirror": {
      "tests": "the credential-evidence fixture verbatim, with its fixture spans",
      "cases": 89
    },
    "probe-vendor-shaped": {
      "tests": "a vendor-shaped value (a prefix, width or grouping the Cases do not claim) assembled at run time: observed, never scored",
      "cases": 52
    }
  },
