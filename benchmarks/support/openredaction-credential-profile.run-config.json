{
  "schema": "credential-eval/run-config/v1",
  "scanners": [
    {
      "id": "openredaction-credential-bearing",
      "adapter": {
        "id": "openredaction-credential-bearing",
        "version": "1"
      },
      "mode": "Published npm package \u00b7 explicit allowlist of credential-bearing types \u00b7 diagnostic profile",
      "configuration": {
        "family_mapping_version": 2,
        "node": "node",
        "options": {
          "patterns": [
            "AWS_ACCESS_KEY",
            "AWS_ARN",
            "AWS_SECRET_KEY",
            "AZURE_RESOURCE_ID",
            "AZURE_STORAGE_KEY",
            "BEARER_TOKEN",
            "COOKIE_SESSION",
            "DATABASE_CONNECTION",
            "DOCKER_AUTH",
            "FIREBASE_API_KEY",
            "GCP_SERVICE_ACCOUNT",
            "GENERIC_API_KEY",
            "GENERIC_SECRET",
            "GITHUB_TOKEN",
            "GOOGLE_API_KEY",
            "HEROKU_API_KEY",
            "JWT_TOKEN",
            "KUBERNETES_SECRET",
            "MAILGUN_API_KEY",
            "NPM_TOKEN",
            "OAUTH_CLIENT_SECRET",
            "OAUTH_TOKEN",
            "OPENAI_API_KEY",
            "PRIVATE_KEY",
            "PYPI_TOKEN",
            "SENDGRID_API_KEY",
            "SESSION_ID",
            "SLACK_TOKEN",
            "SLACK_WEBHOOK",
            "SSH_PRIVATE_KEY",
            "STRIPE_API_KEY",
            "TWILIO_API_KEY",
            "URL_WITH_AUTH"
          ]
        },
        "package": "@openredaction/core",
        "package_source": "published",
        "profile": "credential-bearing-allowlist"
      },
      "network": "disabled",
      "limits": {
        "timeout_ms": 1800000,
        "max_stdout_bytes": 268435456,
        "max_stderr_bytes": 1048576,
        "concurrency": 2
      },
      "pin": {
        "version": "1.1.5",
        "integrity": "sha512-SpQTBhVV4p3rmge818NH6iJiL/fvwFlDvhGaejoL0wbzY7jRHIhU5vEf3KzNARsIZmpCJV1eHdiavIjQyN1hXQ==",
        "resolved": "https://registry.npmjs.org/@openredaction/core/-/core-1.1.5.tgz"
      }
    }
  ],
  "methods": [],
  "execution": {
    "jobs": 2
  },
  "accounting": {
    "min_denominator": 5,
    "resolved_rate_floor": {
      "default": 0.9,
      "differential": 0.0
    },
    "measurable_share_floor": {
      "default": 0.7,
      "policy": 0.0
    },
    "twin_coverage_floor": {
      "default": 0.5,
      "policy": 0.0
    },
    "replays": 2,
    "interval_z": 1.96,
    "interval_precision": 6
  }
}