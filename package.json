{
  "name": "redact-secret-benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "scripts": {
    "go-production": "bash scripts/go-production.sh",
    "prepare": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "prebench": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "predev": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "prebuild": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pretest": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pretest:integration": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pretest:coverage": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "precompare": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "bench": "node --import tsx benchmarks/run.ts",
    "eval": "node --import tsx benchmarks/evaluate.ts",
    "eval:publish": "node --import tsx scripts/publish-evaluation.ts",
    "eval:publish:domains": "node --import tsx scripts/publish-evaluation-domains.ts",
    "eval:publish:pii-support": "node --import tsx scripts/publish-pii-support.ts",
    "eval:discover": "node --import tsx benchmarks/evaluate.ts",
    "start": "npm run bench && vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.mjs",
    "compare": "npm run fixtures:check && npm test && npm run test:integration && npm run bench -- --strict",
    "fixtures:generate": "node --import tsx scripts/generate-fixtures.mjs",
    "fixtures:check": "node --import tsx scripts/generate-fixtures.mjs --check && node --import tsx scripts/check-fixture-storage.mjs",
    "fixture-index:generate": "node --import tsx scripts/generate-fixture-index.mjs",
    "fixture-index:check": "node --import tsx scripts/generate-fixture-index.mjs --check",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include='benchmarks/**/*.ts' --test-coverage-include='scanners/**' --test tests/*.test.mjs tests/integration/*.test.mjs",
    "detectors:refresh": "python3 scripts/refresh-detector-inventory.py",
    "detectors:check": "python3 scripts/refresh-detector-inventory.py --check",
    "peer-rules:check": "node --import tsx scripts/check-peer-rule-families.mjs",
    "pins:check": "node --import tsx scripts/check-pin-drift.mjs",
    "pins:check:local": "node --import tsx scripts/check-pin-drift.mjs --local-only",
    "promotion:check": "node --import tsx scripts/check-promotion-consistency.mjs",
    "promotion:check:local": "node --import tsx scripts/check-promotion-consistency.mjs --local-only",
    "prepins:manifest": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pins:manifest": "node --import tsx scripts/generate-pin-manifest.mjs",
    "prepins:manifest:check": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pins:manifest:check": "node --import tsx scripts/generate-pin-manifest.mjs --check",
    "baseline": "node --import tsx scripts/baseline.mjs",
    "baseline:report": "node --import tsx scripts/baseline.mjs --report",
    "baseline:check-t3": "node --import tsx scripts/check-t3-comparison.mjs",
    "typecheck": "tsc --noEmit",
    "eval:holdout": "node --import tsx benchmarks/holdout.ts",
    "eval:qualify": "node --import tsx benchmarks/qualify.ts",
    "eval:classify": "node --import tsx benchmarks/classify-support.ts",
    "eval:matrix": "node --import tsx benchmarks/generate-support-matrix.ts",
    "eval:publish:matrix": "node --import tsx scripts/publish-support-matrix.ts",
    "eval:matrix:drift": "node --import tsx benchmarks/support-matrix-drift.ts",
    "dossiers:scaffold": "node scripts/scaffold-dossiers.mjs",
    "dossiers:check": "node scripts/scaffold-dossiers.mjs --check",
    "dossiers:publish": "node --import tsx benchmarks/generate-provider-dossiers.ts",
    "family:new": "node scripts/family-new.mjs",
    "family:status": "node scripts/family-status.mjs",
    "contribution:readiness": "node --import tsx scripts/contribution-readiness.mjs",
    "support:check:ui": "node --import tsx scripts/check-support-ui.mjs",
    "arrival:check": "node --import tsx scripts/check-evidence-arrival.mjs",
    "profiles:generate": "node --import tsx scripts/generate-fixture-profile-coverage.mjs",
    "profiles:check": "node --import tsx scripts/generate-fixture-profile-coverage.mjs --check",
    "audit:independence": "node --import tsx scripts/audit-fixture-independence.mjs",
    "beta8:profiles": "node --import tsx scripts/report-beta8-profiles.mjs",
    "decisions:validate": "node scripts/validate-decisions.mjs",
    "qualification-inputs:check": "node scripts/check-qualification-inputs.mjs",
    "official-runs:check": "node --import tsx scripts/check-official-runs.mjs",
    "official-runs:record": "node --import tsx scripts/record-official-run.mjs",
    "qualification:axis-overlay": "node --import tsx scripts/build-axis-overlay.ts",
    "qualification:evidence":"node --import tsx scripts/export-evaluation-evidence.ts",
    "qualification:export":"node --import tsx scripts/export-qualification-population.ts",
    "qualification:view": "node --import tsx scripts/build-qualification-view.ts",
    "qualification:parity": "node --import tsx scripts/build-qualification-parity.ts",
    "ledger:decisions:check": "node scripts/check-ledger-decisions.mjs",
    "ledger:provenance:check": "node --import tsx scripts/check-review-ledger.mjs",
    "queue:check": "node --import tsx scripts/check-review-queue-coverage.mjs",
    "eval:candidate": "node --import tsx benchmarks/candidate.ts",
    "pii:observe:populations": "node --import tsx scripts/observe-pii-populations.mjs",
    "pii:qualify:candidate": "node --import tsx scripts/qualify-pii-family-candidate.mjs",
    "pii:populations:email-network": "node --import tsx scripts/measure-pii-email-network-populations.mjs",
    "pii:support:record": "node --import tsx scripts/record-pii-support-evidence.ts",
    "pii:arrival:refresh": "node --import tsx scripts/refresh-us-ssn-arrival-data.mjs",
    "pii:arrival:observe": "node --import tsx scripts/observe-us-ssn-populations.mjs",
    "pii:arrival:operational": "node --import tsx scripts/measure-pii-arrival-operational.mjs",
    "pii:arrival:holdout": "node --import tsx scripts/run-us-ssn-protected-holdout.mjs",
    "pii:ledger:check": "node --import tsx scripts/check-pii-gap-ledger.mjs",
    "pii:parity:plan": "node --import tsx scripts/generate-pii-mixed-parity.mjs",
    "pii:parity:measure": "node --import tsx scripts/measure-pii-mixed-parity.mjs",
    "credential-parity:plan": "node --import tsx scripts/generate-credential-mixed-parity.mjs",
    "credential-parity:measure": "node --import tsx scripts/measure-credential-mixed-parity.mjs",
    "pii:beta11": "node --import tsx scripts/pii-beta11.mjs",
    "pii:beta11:plans": "node --import tsx scripts/generate-pii-beta11-population-v2.mjs",
    "pii:beta11:protected": "node --import tsx scripts/pii-beta11-protected.mjs",
    "eval:validate": "node --import tsx benchmarks/validate-evidence.ts",
    "eval:diagnostics": "node --import tsx benchmarks/unit-diagnostics.ts",
    "eval:diagnostics:validate": "node --import tsx scripts/validate-unit-diagnostics.mjs",
    "eval:dry-run": "node --import tsx scripts/accounting-dry-run.ts",
    "eval:milestone": "node scripts/refresh-evaluation-milestone.mjs",
    "performance:criteria": "node --import tsx scripts/derive-performance-criteria.mjs",
    "performance:criteria:check": "node --import tsx scripts/derive-performance-criteria.mjs --check",
    "performance:schema:check": "node scripts/check-performance-schema.mjs",
    "performance:schema:drift-check": "node --import tsx scripts/check-performance-schema-drift.mjs",
    "performance:evaluate": "node --import tsx benchmarks/evaluate-performance.ts",
    "performance:budgets:derive": "node --import tsx scripts/regression-budgets.mjs derive",
    "performance:budgets:check": "node --import tsx scripts/regression-budgets.mjs check",
    "performance:budgets:evaluate": "node --import tsx scripts/regression-budgets.mjs evaluate",
    "performance:budgets:backtest": "node --import tsx scripts/regression-budgets.mjs backtest",
    "performance:noise": "node --import tsx scripts/measure-regression-noise.mjs",
    "adversarial:check": "node --import tsx scripts/check-adversarial-intake.mjs",
    "adversarial:rerun": "node --import tsx scripts/rerun-adversarial-candidate.mjs",
    "mcp:qualify": "node --import tsx benchmarks/mcp-qualification.ts",
    "tuning:check": "node --import tsx scripts/check-tuning-manifests.mjs",
    "scorer-promotion:check": "node --import tsx scripts/check-scorer-promotion-contract.mjs",
    "preevasion:run": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "evasion:run": "node --import tsx benchmarks/score-evasion.ts",
    "prefeatures:extract": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "features:extract": "node --import tsx benchmarks/candidate-features.ts",
    "features:check-public": "node scripts/check-feature-dataset-exclusion.mjs",
    "blind:run": "node --import tsx benchmarks/blind.ts",
    "blind:check-public": "node --import tsx scripts/check-blind-public.mjs",
    "calibration:run": "node --import tsx benchmarks/calibration-experiments.ts",
    "study:pii-readiness": "node --import tsx benchmarks/studies/pii-readiness.ts",
    "evidence:query": "node --import tsx benchmarks/evidence-query.ts",
    "observations:capture": "node --import tsx scripts/capture-empirical-observation.ts",
    "peers:provision": "node scripts/provision-peers.mjs",
    "peers:snapshots:refresh": "npm run bench -- --strict --refresh-peer-snapshots && npm run eval:classify -- --refresh-peer-snapshots",
    "peers:snapshots:live": "npm run bench -- --strict --live-peers && npm run eval:classify -- --live-peers",
    "peer-pii-runtime-throughput": "node --import tsx scripts/measure-peer-pii-runtime-throughput.mjs",
    "runtime-comparison": "node --import tsx scripts/measure-runtime-comparison.mjs"
  },
  "description": "Project-maintained synthetic regression and range benchmarks comparing redact-secret against Gitleaks, TruffleHog and flare-redact on identical fixture sets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-benchmarks.git"
  },
  "dependencies": {
    "@openredaction/core": "1.1.5",
    "@redact-secret/core": "0.1.0-beta.12",
    "flare-redact": "1.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "ajv": "8.20.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "yaml": "2.9.1"
  }
}
