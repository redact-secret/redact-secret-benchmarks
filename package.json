{
  "name": "redact-secret-benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "scripts": {
    "prepare": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "prebench": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "predev": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "prebuild": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pretest": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pretest:integration": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pretest:coverage": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "precompare": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "bench": "node --import tsx benchmarks/run.ts",
    "eval": "node --import tsx benchmarks/evaluate.ts",
    "eval:publish": "node --import tsx scripts/publish-evaluation.ts",
    "eval:discover": "node --import tsx benchmarks/evaluate.ts",
    "start": "npm run bench && vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.mjs",
    "compare": "npm run fixtures:check && npm test && npm run test:integration && npm run bench -- --strict",
    "fixtures:generate": "node --import tsx scripts/generate-fixtures.mjs",
    "fixtures:check": "node --import tsx scripts/generate-fixtures.mjs --check && node --import tsx scripts/check-fixture-storage.mjs",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include='benchmarks/**/*.ts' --test-coverage-include='scanners/**' --test tests/*.test.mjs tests/integration/*.test.mjs",
    "detectors:refresh": "python3 scripts/refresh-detector-inventory.py",
    "detectors:check": "python3 scripts/refresh-detector-inventory.py --check",
    "pins:check": "node --import tsx scripts/check-pin-drift.mjs",
    "pins:check:local": "node --import tsx scripts/check-pin-drift.mjs --local-only",
    "promotion:check": "node --import tsx scripts/check-promotion-consistency.mjs",
    "promotion:check:local": "node --import tsx scripts/check-promotion-consistency.mjs --local-only",
    "prepins:manifest": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pins:manifest": "node --import tsx scripts/generate-pin-manifest.mjs",
    "prepins:manifest:check": "node --import tsx scripts/generate-fixtures.mjs --ensure",
    "pins:manifest:check": "node --import tsx scripts/generate-pin-manifest.mjs --check",
    "baseline": "node --import tsx scripts/baseline.mjs",
    "baseline:report": "node --import tsx scripts/baseline.mjs --report",
    "typecheck": "tsc --noEmit",
    "eval:holdout": "node --import tsx benchmarks/holdout.ts",
    "eval:qualify": "node --import tsx benchmarks/qualify.ts",
    "eval:classify": "node --import tsx benchmarks/classify-support.ts",
    "eval:matrix": "node --import tsx benchmarks/generate-support-matrix.ts",
    "eval:publish:matrix": "node --import tsx scripts/publish-support-matrix.ts",
    "eval:matrix:drift": "node --import tsx benchmarks/support-matrix-drift.ts",
    "support:check:ui": "node --import tsx scripts/check-support-ui.mjs",
    "arrival:check": "node --import tsx scripts/check-evidence-arrival.mjs",
    "profiles:generate": "node --import tsx scripts/generate-fixture-profile-coverage.mjs",
    "profiles:check": "node --import tsx scripts/generate-fixture-profile-coverage.mjs --check",
    "beta8:profiles": "node --import tsx scripts/report-beta8-profiles.mjs",
    "decisions:validate": "node scripts/validate-decisions.mjs",
    "ledger:decisions:check": "node scripts/check-ledger-decisions.mjs",
    "queue:check": "node --import tsx scripts/check-review-queue-coverage.mjs",
    "eval:candidate": "node --import tsx benchmarks/candidate.ts",
    "eval:validate": "node --import tsx benchmarks/validate-evidence.ts",
    "eval:dry-run": "node --import tsx scripts/accounting-dry-run.ts",
    "eval:milestone": "node scripts/refresh-evaluation-milestone.mjs",
    "performance:criteria": "node --import tsx scripts/derive-performance-criteria.mjs",
    "performance:criteria:check": "node --import tsx scripts/derive-performance-criteria.mjs --check",
    "performance:schema:check": "node scripts/check-performance-schema.mjs",
    "performance:schema:drift-check": "node --import tsx scripts/check-performance-schema-drift.mjs",
    "performance:evaluate": "node --import tsx benchmarks/evaluate-performance.ts",
    "adversarial:check": "node --import tsx scripts/check-adversarial-intake.mjs",
    "tuning:check": "node --import tsx scripts/check-tuning-manifests.mjs",
    "evidence:query": "node --import tsx benchmarks/evidence-query.ts",
    "observations:capture": "node --import tsx scripts/capture-empirical-observation.ts",
    "peers:provision": "node scripts/provision-peers.mjs"
  },
  "description": "Project-maintained synthetic regression and range benchmarks comparing redact-secret against Gitleaks, TruffleHog and flare-redact on identical fixture sets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-benchmarks.git"
  },
  "dependencies": {
    "@redact-secret/core": "0.1.0-beta.8",
    "flare-redact": "1.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "ajv": "8.20.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
