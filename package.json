{
  "name": "redact-secret-benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "scripts": {
    "bench": "node benchmarks/run.mjs",
    "start": "npm run bench && vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "compare": "npm run fixtures:check && npm test && npm run test:integration && npm run bench -- --strict",
    "test:redaction": "node --test tests/redaction.test.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:check": "node scripts/generate-fixtures.mjs --check",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='benchmarks/lib/**' --test-coverage-include='scanners/**' --test tests/*.test.mjs tests/integration/*.test.mjs",
    "detectors:refresh": "python3 scripts/refresh-detector-inventory.py",
    "detectors:check": "python3 scripts/refresh-detector-inventory.py --check"
  },
  "description": "Project-maintained synthetic regression and range benchmarks comparing redact-secret against Gitleaks and TruffleHog on identical fixture sets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-benchmarks.git"
  },
  "dependencies": {
    "@redact-secret/core": "0.1.0-beta.3"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
