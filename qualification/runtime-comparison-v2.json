{
  "schemaVersion": 1,
  "id": "runtime-comparison-v2",
  "issues": [
    562,
    563
  ],
  "supportClaims": false,
  "purpose": "Informational-only runtime comparison behind /comparison/runtime: what each library and each redact-secret setting did to each value in the text, and how long one call took, on three PII and three credential workloads. Extends peer-pii-runtime-throughput-v1 (#429) without editing it. Never a gate, never a ranking (AGENTS.md Boundary rule).",
  "extends": {
    "id": "peer-pii-runtime-throughput-v1",
    "path": "qualification/peer-pii-runtime-throughput-v1.json",
    "contentCommitment": "d1e14a01c355ec73c03cc7b3f6f5f8c298a7a6ee9614041e156d883d467456b5"
  },
  "safety": {
    "realPersonOrAccountProvenance": false,
    "credentialInputs": "generated-at-run-time",
    "evidenceProjection": "outcome-with-values-replaced-by-index"
  },
  "settings": [
    {
      "id": "default",
      "label": "Default",
      "sub": "no PII",
      "selectors": []
    },
    {
      "id": "pii-global",
      "label": "PII",
      "sub": "pii:global",
      "selectors": [
        "pii:global"
      ]
    },
    {
      "id": "pii-global-us",
      "label": "PII + US",
      "sub": "adds pii:us",
      "selectors": [
        "pii:global",
        "pii:us"
      ]
    }
  ],
  "tools": [
    {
      "id": "redact-secret",
      "package": "@redact-secret/core",
      "call": "scanAndRedact",
      "async": false
    },
    {
      "id": "flare-redact",
      "package": "flare-redact",
      "call": "redact",
      "async": false
    },
    {
      "id": "openredaction",
      "package": "@openredaction/core",
      "call": "detect",
      "async": true
    }
  ],
  "sampleProtocol": {
    "samplesPerCell": 12,
    "warmupSamples": 2,
    "processIsolation": "one-process-per-setting-tools-in-process",
    "order": "round-robin-per-tool"
  },
  "generator": {
    "algorithm": "repeat-lines-v1",
    "lineCount": 4096,
    "lineSeparator": "LF"
  },
  "outcomeDefinition": {
    "changed": "true when the call returned text different from the line it was given.",
    "valuesHidden": "how many of the values the line carries no longer appear verbatim in the returned text. A line that changed but still shows every value is recorded as 0.",
    "replacement": "the text that took the place of what changed, with any value of the line replaced by its index in braces, cut to 64 characters. Empty when nothing changed."
  },
