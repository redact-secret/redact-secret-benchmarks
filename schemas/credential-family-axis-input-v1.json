{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "issue",
    "consumer",
    "frozenAt",
    "status",
    "baseline",
    "rules",
    "selection",
    "reserve",
    "exclusions",
    "budgetTotals"
  ],
  "properties": {
    "schema": {
      "const": "beta11-family-axis-ledger-v1"
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "family",
          "rank",
          "budget",
          "positives",
          "benign",
          "twins"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "budget": {
            "type": "object"
          },
          "positives": {
            "type": "array"
          },
          "benign": {
            "type": "array"
          },
          "twins": {
            "type": "array"
          }
        }
      }
    },
    "issue": {
      "type": "string"
    },
    "consumer": {
      "type": "string"
    },
    "frozenAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "baseline": {
      "type": "object"
    },
    "rules": {
      "type": "array"
    },
    "reserve": {
      "type": "array"
    },
    "exclusions": {
      "type": "array"
    },
    "budgetTotals": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
