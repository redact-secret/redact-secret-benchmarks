{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret:credential-policy-holdout:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "domain", "evaluationProfile", "domainAccountingVersion", "reportProfile", "supportClaims", "runId", "planHash", "startedAt", "finishedAt", "status", "methodology", "independence", "corpus", "candidate", "caseCount", "variantCount", "generationErrors", "scanners", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportType": { "const": "credential-policy-holdout" },
    "domain": { "const": "credential-policy" },
    "evaluationProfile": { "const": "credential-policy-v1" },
    "domainAccountingVersion": { "const": "credential-policy-v1" },
    "reportProfile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "credential-policy-holdout" }, "version": { "const": 1 } } },
    "supportClaims": { "const": false },
    "runId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "planHash": { "$ref": "#/definitions/digest" },
    "startedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "finishedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "status": { "enum": ["complete", "incomplete"] },
    "methodology": { "const": "frozen-candidate-canonical-cases-aggregate-only" },
    "independence": { "enum": ["public-control", "custodian-declared"] },
    "corpus": { "type": "object" },
    "candidate": { "type": "object" },
    "caseCount": { "type": "integer", "minimum": 1 },
    "variantCount": { "type": "integer", "minimum": 1 },
    "generationErrors": { "type": "integer", "minimum": 0 },
    "scanners": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "version", "configuration", "configurationHash", "status"], "properties": { "id": { "type": "string" }, "version": { "type": ["string", "null"] }, "configuration": { "type": "object" }, "configurationHash": { "$ref": "#/definitions/digest" }, "status": { "enum": ["complete", "unsupported", "unavailable", "error", "unstable"] } } } },
    "families": { "type": "object", "additionalProperties": false, "required": ["bearer-token", "connection-string", "otpauth-uri", "generic-token"], "properties": {
      "bearer-token": { "$ref": "#/definitions/family" }, "connection-string": { "$ref": "#/definitions/family" }, "otpauth-uri": { "$ref": "#/definitions/family" }, "generic-token": { "$ref": "#/definitions/family" }
    } }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "family": { "type": "object", "additionalProperties": false, "required": ["cases", "positives", "benign", "twins", "spans", "exact", "covered", "overbroad", "partial", "miss", "collateralBytes", "actionMismatches", "blockFindings", "failures"], "properties": {
      "cases": { "type": "integer", "minimum": 0 }, "positives": { "type": "integer", "minimum": 0 }, "benign": { "type": "integer", "minimum": 0 }, "twins": { "type": "integer", "minimum": 0 }, "spans": { "type": "integer", "minimum": 0 }, "exact": { "type": "integer", "minimum": 0 }, "covered": { "type": "integer", "minimum": 0 }, "overbroad": { "type": "integer", "minimum": 0 }, "partial": { "type": "integer", "minimum": 0 }, "miss": { "type": "integer", "minimum": 0 }, "collateralBytes": { "type": "integer", "minimum": 0 }, "actionMismatches": { "type": "integer", "minimum": 0 }, "blockFindings": { "type": "integer", "minimum": 0 }, "failures": { "type": "integer", "minimum": 0 }
    }
  }
}
}
