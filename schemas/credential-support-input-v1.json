{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:current-credential-support:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "inputType": {
      "const": "current-credential-support-bindings"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publishedVersion": {
          "type": "string"
        },
        "publishedSourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "candidateSourceCommits": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      },
      "required": [
        "publishedVersion",
        "publishedSourceCommit",
        "candidateSourceCommits"
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "published",
              "candidate"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^evidence/[A-Za-z0-9_./-]+\\.json$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "productSourceCommit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "required": [
              "path",
              "revision",
              "sha256",
              "productSourceCommit"
            ]
          },
          "dataSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "generatedAt": {
                "type": "string"
              },
              "familyCount": {
                "type": "integer",
                "minimum": 0
              },
              "distribution": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stable": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "provisional": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pending": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unsupported": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "stable",
                  "provisional",
                  "pending",
                  "unsupported"
                ]
              },
              "stableDistribution": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "documented": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "empirical": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "policyQualified": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "documented",
                  "empirical",
                  "policyQualified"
                ]
              },
              "product": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sourceCommit": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      },
                      "declaredVersion": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sourceCommit",
                      "declaredVersion"
                    ]
                  }
                ]
              },
              "publishedPackage": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "packageName": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "version"
                    ]
                  }
                ]
              },
              "families": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "family": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "stable",
                        "provisional",
                        "pending",
                        "unsupported"
                      ]
                    },
                    "qualificationProfile": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "family",
                    "status"
                  ]
                }
              }
            },
            "required": [
              "schemaVersion",
              "generatedAt",
              "familyCount",
              "distribution",
              "stableDistribution",
              "product",
              "publishedPackage",
              "families"
            ]
          }
        },
        "required": [
          "mode",
          "source",
          "dataSha256",
          "data"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "inputType",
    "scope",
    "records"
  ]
}
