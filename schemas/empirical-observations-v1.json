{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:empirical-observations:1",
  "$defs": {
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "owner", "reference", "observedAt", "supports"],
      "properties": {
        "class": { "enum": ["peer-scanner-rule", "provider-owned-code", "provider-example", "independent-implementation", "independent-research"] },
        "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "reference": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "supports": { "type": "string", "minLength": 1 }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "status"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["bounded", "settled", "unresolved"] },
        "bound": { "type": "string", "minLength": 1 },
        "settledBy": { "type": "string", "pattern": "^https://[^\\s]+$" }
      },
      "$comment": "bounded requires bound and no settledBy; settled requires both; unresolved carries neither. Enforced by validateEmpiricalObservations, which also requires settledBy to name a provider-owned-code or provider-example reference of the same family."
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "credentialFamily", "observedAt", "issuedAt", "issuanceRoute", "subjectKind", "subjectId", "evidenceBasis", "independenceClass", "structure", "revokedAfterObservation", "rawValueRetained"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "credentialFamily": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "issuedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "issuanceRoute": { "type": "string", "minLength": 1 },
        "subjectKind": { "enum": ["account", "project"] },
        "subjectId": { "type": "string", "pattern": "^subject-[a-z0-9-]+$" },
        "evidenceBasis": { "const": "empirically-observed" },
        "independenceClass": { "enum": ["provider-issuance"] },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalLength", "prefix", "segmentLengths", "alphabetClasses", "separators", "checksumBehavior"],
          "properties": {
            "totalLength": { "type": "integer", "minimum": 1 },
            "prefix": { "type": ["string", "null"], "maxLength": 32 },
            "segmentLengths": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
            "alphabetClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lower", "upper", "digit", "hex", "base32", "base58", "base64", "base64url", "mixed-ascii"] } },
            "separators": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["dash", "underscore", "dot", "none"] } },
            "checksumBehavior": { "enum": ["present", "absent", "unknown"] }
          }
        },
        "revokedAfterObservation": { "type": "boolean" },
        "rawValueRetained": { "const": false }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "mode", "supportsBareValues", "uncertainty", "supportedContexts", "observations", "corroboration", "contradictions"],
        "properties": {
          "family": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "mode": { "enum": ["shape", "context-constrained"] },
          "supportsBareValues": { "type": "boolean" },
          "uncertainty": { "type": "string", "minLength": 1 },
          "supportedContexts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "observations": {
            "type": "array",
            "items": { "$ref": "#/$defs/observation" }
          },
          "corroboration": {
            "type": "array",
            "items": { "$ref": "#/$defs/corroboration" }
          },
          "contradictions": { "type": "array", "items": { "$ref": "#/$defs/contradiction" } }
        }
      }
    }
  }
}
