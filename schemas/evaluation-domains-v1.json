{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:evaluation-domains:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "supportClaims", "domains"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportType": { "const": "evaluation-domains" },
    "supportClaims": { "const": false },
    "domains": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "reportProfile", "evaluationProfile", "domainAccountingVersion", "qualificationProfiles", "evaluation", "support"],
        "properties": {
          "domain": { "enum": ["credential", "pii"] },
          "reportProfile": { "$ref": "#/$defs/profile" },
          "evaluationProfile": { "enum": ["evaluation-v1", "pii-v1"] },
          "domainAccountingVersion": { "enum": ["credential-v4", "pii-v1"] },
          "qualificationProfiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/profile" }
          },
          "evaluation": { "$ref": "#/$defs/publication" },
          "support": { "$ref": "#/$defs/publication" }
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "enum": ["credential-evaluation", "pii-evaluation", "documented", "empirical", "pii-v1"] },
        "version": { "const": 1 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "href"],
      "properties": {
        "state": { "enum": ["published", "schema-only"] },
        "href": { "type": ["string", "null"], "pattern": "^/results/[a-z0-9-]+\\.json$" }
      }
    }
  }
}
