{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:evaluation-domains:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "supportClaims", "domains"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "reportType": { "const": "evaluation-domains" },
    "supportClaims": { "const": false },
    "domains": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain", "reportProfile", "evaluationProfile", "domainAccountingVersion", "qualificationProfiles", "evaluation", "support"],
        "properties": {
          "domain": { "enum": ["credential", "pii"] },
          "reportProfile": { "$ref": "#/$defs/profile" },
          "evaluationProfile": { "enum": ["evaluation-v1", "pii-v1"] },
          "domainAccountingVersion": { "enum": ["credential-v4", "pii-v1"] },
          "qualificationProfiles": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/profile" } },
          "evaluation": { "oneOf": [{ "$ref": "#/$defs/publication" }, { "$ref": "#/$defs/bundlePublication" }] },
          "support": { "$ref": "#/$defs/publication" }
        }
      }
    }
  },
  "$defs": {
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {
      "id": { "enum": ["credential-evaluation", "pii-evaluation", "documented", "empirical", "pii-v1"] }, "version": { "const": 1 }
    } },
    "bundlePublication": { "type": "object", "additionalProperties": false, "required": ["state", "href", "artifactCommitment"], "properties": {
      "state": { "const": "published" },
      "href": { "type": "string", "pattern": "^/results/evaluation-bundles/[a-f0-9]{32}/manifest\\.json$" },
      "artifactCommitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    } },
    "publication": { "type": "object", "additionalProperties": false, "required": ["state", "href", "artifactCommitment"], "properties": {
      "state": { "enum": ["published", "schema-only"] },
      "href": { "type": ["string", "null"], "pattern": "^/results/[a-z0-9-]+\\.json$" },
      "artifactCommitment": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
    } }
  }
}
