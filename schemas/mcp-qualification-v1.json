{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:mcp-qualification:1",
  "title": "Black-box MCP adapter boundary and operational qualification (#281)",
  "description": "Outcomes, sink-level containment verdicts, counts and timings only. A report never carries a matched value: the harness refuses to write one that contains any synthetic value or fragment.",
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "size": {
      "type": "object",
      "required": ["packedBytes", "unpackedBytes", "files"],
      "properties": { "packedBytes": { "type": "integer", "minimum": 1 }, "unpackedBytes": { "type": "integer", "minimum": 1 }, "files": { "type": "integer", "minimum": 1 } }
    },
    "outcome": {
      "type": "object", "required": ["outcome"],
      "properties": { "outcome": { "type": "string" }, "reason": { "type": "string" }, "code": { "type": "string" } }
    },
    "verdict": {
      "type": "object",
      "required": ["id", "area", "expected", "observed", "containment", "sinks", "checks", "conforms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "area": { "type": "string" },
        "expected": { "$ref": "#/definitions/outcome" },
        "observed": { "$ref": "#/definitions/outcome" },
        "containment": { "enum": ["contained", "leak", "known-false-negative", "delivered-by-policy", "control-detected", "control-missed"] },
        "sinks": { "type": "array", "items": { "enum": ["model-context", "host-log", "store", "audit", "error-text", "server-wire", "tool-input"] } },
        "checks": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "additionalProperties": false, "required": ["name", "passed"], "properties": { "name": { "type": "string" }, "passed": { "type": "boolean" } } }
        },
        "conforms": { "type": "boolean" },
        "exclusion": { "enum": ["split-across-blocks", "split-across-fields", "split-across-calls"] },
        "observations": { "type": "object" }
      }
    },
    "cell": {
      "type": "object",
      "required": ["node", "line", "endpoint", "sdk", "transport", "protocolVersion", "status"],
      "properties": {
        "node": { "type": "string", "pattern": "^node-\\d+\\.\\d+\\.\\d+$" },
        "line": { "enum": ["v1", "v2"] },
        "endpoint": { "enum": ["lowest", "highest"] },
        "sdk": { "type": "object", "additionalProperties": { "type": "string" } },
        "transport": { "enum": ["stdio", "http"] },
        "protocolVersion": { "type": ["string", "null"] },
        "status": { "enum": ["complete", "failed"] },
        "failure": { "type": "string" },
        "summary": {
          "type": "object",
          "required": ["cases", "controlsDetected", "leaks", "knownFalseNegatives", "deliveredByPolicy", "deviations"],
          "properties": {
            "cases": { "type": "integer" }, "controlsDetected": { "type": "integer" }, "leaks": { "type": "integer" },
            "knownFalseNegatives": { "type": "integer" }, "deliveredByPolicy": { "type": "integer" }, "deviations": { "type": "integer" }
          }
        },
        "processOutput": {
          "type": "object", "required": ["hostStdout", "hostStderr", "serverStderr"],
          "properties": { "hostStdout": { "type": "boolean" }, "hostStderr": { "type": "boolean" }, "serverStderr": { "type": "boolean" } }
        },
        "cases": { "type": "array", "items": { "$ref": "#/definitions/verdict" } }
      }
    }
  },
  "type": "object",
  "required": ["schema", "issue", "status", "quick", "startedAt", "finishedAt", "benchmark", "contract", "artifacts", "host", "configuration", "summary", "matrix", "operational", "notMeasured"],
  "properties": {
    "schema": { "const": "redact-secret-benchmarks/mcp-qualification-v1" },
    "issue": { "const": 281 },
    "status": { "enum": ["complete", "incomplete"] },
    "quick": { "type": "boolean" },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "benchmark": {
      "type": "object", "required": ["repository", "commit", "dirty"],
      "properties": { "repository": { "const": "redact-secret/redact-secret-benchmarks" }, "commit": { "$ref": "#/definitions/commit" }, "dirty": { "type": "boolean" } }
    },
    "contract": { "type": "object", "required": ["reference", "decision"] },
    "artifacts": {
      "type": "object", "required": ["core", "adapters", "compatibility"],
      "properties": {
        "core": {
          "type": "object", "required": ["sourceCommit", "packages"],
          "properties": {
            "sourceCommit": { "$ref": "#/definitions/commit" },
            "packages": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": {
                "allOf": [{ "$ref": "#/definitions/size" }],
                "type": "object", "required": ["role", "file", "sha256"],
                "properties": { "role": { "enum": ["core", "node", "wasm"] }, "file": { "type": "string" }, "sha256": { "$ref": "#/definitions/sha256" } }
              }
            }
          }
        },
        "adapters": {
          "type": "object", "required": ["repository", "commit", "pinSource", "packages"],
          "properties": {
            "repository": { "const": "redact-secret/redact-secret-adapters" },
            "commit": { "$ref": "#/definitions/commit" },
            "pinSource": { "type": "object", "required": ["file", "sha256"], "properties": { "sha256": { "$ref": "#/definitions/sha256" } } },
            "packages": {
              "type": "array", "minItems": 1,
              "items": {
                "allOf": [{ "$ref": "#/definitions/size" }],
                "type": "object", "required": ["name", "version", "contentDigest", "verified", "tarballSha256"],
                "properties": {
                  "name": { "type": "string", "pattern": "^@redact-secret/[a-z0-9-]+$" }, "version": { "type": "string" },
                  "contentDigest": { "$ref": "#/definitions/contentDigest" }, "verified": { "const": true }, "tarballSha256": { "$ref": "#/definitions/sha256" }
                }
              }
            }
          }
        },
        "compatibility": {
          "type": "object", "required": ["file", "sha256", "runtimeRange", "endpoints"],
          "properties": { "sha256": { "$ref": "#/definitions/sha256" }, "endpoints": { "type": "array", "minItems": 4, "maxItems": 4 } }
        }
      }
    },
    "host": { "type": "object", "required": ["os", "arch", "cpuModel", "logicalCpus", "totalMemoryBytes", "driverRuntime"] },
    "configuration": { "type": "object", "required": ["limits", "binaryContent", "policy", "placement", "corpus"] },
    "summary": {
      "type": "object",
      "required": ["cells", "completeCells", "caseRuns", "leaks", "deviations", "knownFalseNegatives", "deliveredByPolicy", "processOutputLeaks"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "matrix": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cell" } },
    "operational": {
      "type": "object", "required": ["note", "overhead", "initialization"],
      "properties": {
        "overhead": {
          "type": "object", "required": ["runtime", "summary", "series"],
          "properties": {
            "summary": { "type": "array" },
            "series": {
              "type": "object", "required": ["schema", "issue", "outputs"],
              "properties": {
                "schema": { "const": "redact-secret-benchmarks/adapter-overhead-series-v1" },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "object", "required": ["schema", "language", "workloads", "environment", "method", "results"],
                    "properties": { "schema": { "const": "redact-secret-benchmarks/mcp-overhead-v1" }, "language": { "const": "mcp-javascript" } }
                  }
                }
              }
            }
          }
        },
        "initialization": { "type": ["object", "null"] }
      }
    },
    "notMeasured": { "type": "array", "items": { "type": "string" } }
  }
}
