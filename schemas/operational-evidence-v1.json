{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:operational-evidence:1",
  "title": "Operational performance and artifact-size evidence (#141)",
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["median", "p95", "minimum", "maximum", "standardDeviation", "samples", "unit"],
      "properties": {
        "median": { "type": "number" }, "p95": { "type": "number" }, "minimum": { "type": "number" }, "maximum": { "type": "number" },
        "standardDeviation": { "type": "number" }, "samples": { "type": "integer", "minimum": 1 }, "unit": { "const": "milliseconds" }
      }
    },
    "memoryCategory": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["unavailableReason"], "properties": { "unavailableReason": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["maximumObservedBytes", "maximumGrowthBytes", "samples", "unit"],
          "properties": { "maximumObservedBytes": { "type": "integer", "minimum": 0 }, "maximumGrowthBytes": { "type": ["integer", "null"], "minimum": 0 },
            "samples": { "type": "integer", "minimum": 1 }, "unit": { "const": "bytes" } } }
      ]
    },
    "binary": {
      "type": "object", "additionalProperties": false, "required": ["target", "file", "bytes", "sha256"],
      "properties": { "target": { "type": "string" }, "file": { "type": "string" }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha" } }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "issue", "sourceCommit", "productVersion", "measuredAt", "provenance", "measurements", "judgement", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "issue": { "const": 141 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "productVersion": { "type": "string" },
    "measuredAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["performanceRun", "performanceSummaryPath", "qualificationRun", "repetitions", "workloadProfiles", "officialProfile", "buildProfile"],
      "properties": {
        "performanceRun": { "type": "string", "pattern": "^\\d+$" }, "performanceSummaryPath": { "type": "string" },
        "qualificationRun": { "type": "string", "pattern": "^\\d+$" }, "repetitions": { "type": "integer", "minimum": 1 },
        "workloadProfiles": { "type": "object" }, "officialProfile": { "type": "string" }, "buildProfile": { "type": "string" }
      }
    },
    "measurements": {
      "type": "object", "additionalProperties": false, "required": ["timings", "artifacts", "browserBundle"],
      "properties": {
        "timings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["surface", "profileId", "path", "environment", "initialization", "processing", "throughput", "memory"],
            "properties": {
              "surface": { "enum": ["rust-core", "node", "browser-wasm", "python", "cli"] },
              "profileId": { "type": "string" }, "path": { "type": "string" },
              "environment": { "type": "object", "required": ["os", "cpu", "runtime", "buildProfile", "artifactIdentity"] },
              "initialization": { "$ref": "#/$defs/distribution" },
              "processing": { "$ref": "#/$defs/distribution" },
              "throughput": { "type": "object", "additionalProperties": false, "required": ["median", "minimum", "unit"],
                "properties": { "median": { "type": "number" }, "minimum": { "type": "number" }, "unit": { "const": "bytes-per-second" } } },
              "memory": { "type": "object", "additionalProperties": { "$ref": "#/$defs/memoryCategory" } }
            }
          }
        },
        "artifacts": {
          "type": "object", "additionalProperties": false, "required": ["nativeAddons", "pythonWheels", "cli", "wasm", "npmPackages"],
          "properties": {
            "nativeAddons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binary" } },
            "pythonWheels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binary" } },
            "cli": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binary" } },
            "wasm": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
              "required": ["profile", "artifact", "file", "sha256", "rawBytes", "gzipBytes", "brotliBytes", "jsGlueBytes"],
              "properties": { "profile": { "enum": ["full", "common"] }, "artifact": { "type": "string" }, "file": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha" },
                "rawBytes": { "type": "integer", "minimum": 1 }, "gzipBytes": { "type": "integer", "minimum": 1 }, "brotliBytes": { "type": "integer", "minimum": 1 },
                "jsGlueBytes": { "type": ["integer", "null"] } } } },
            "npmPackages": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
              "required": ["label", "file", "packedBytes", "unpackedBytes", "files"],
              "properties": { "label": { "type": "string" }, "file": { "type": "string" }, "packedBytes": { "type": "integer", "minimum": 1 },
                "unpackedBytes": { "type": "integer", "minimum": 1 }, "files": { "type": "integer", "minimum": 1 } } } }
          }
        },
        "browserBundle": {
          "type": "object", "additionalProperties": false, "required": ["tool", "entry", "files", "totals"],
          "properties": {
            "tool": { "type": "string" }, "entry": { "type": "string" },
            "files": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["file", "kind", "bytes", "gzipBytes"],
              "properties": { "file": { "type": "string" }, "kind": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "gzipBytes": { "type": "integer", "minimum": 0 } } } },
            "totals": { "type": "object", "required": ["jsBytes", "jsGzipBytes", "wasmBytes", "wasmGzipBytes", "allBytes", "allGzipBytes"] }
          }
        }
      }
    },
    "judgement": {
      "type": "object", "additionalProperties": false, "required": ["criteriaId", "criteriaFixedAt", "status", "checksPassed", "checksTotal", "note"],
      "properties": { "criteriaId": { "type": "string" }, "criteriaFixedAt": { "type": "string" }, "status": { "enum": ["accepted", "rejected"] },
        "checksPassed": { "type": "integer" }, "checksTotal": { "type": "integer" }, "note": { "type": "string" } }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
