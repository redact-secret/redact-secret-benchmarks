{
  "$id": "urn:redact-secret:pii-accounting:1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "domain", "evaluationProfile", "domainAccountingVersion", "profile", "rowCount", "sourceCaseCount", "inputCommitment", "commitmentTrust", "sources", "metrics", "benignByControlClass", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 }, "reportType": { "const": "pii-accounting" }, "domain": { "const": "pii" },
    "evaluationProfile": { "const": "pii-v1" }, "domainAccountingVersion": { "const": "pii-v1" },
    "profile": { "$ref": "#/$defs/profile" }, "rowCount": { "type": "integer", "minimum": 0 },
    "sourceCaseCount": { "type": "integer", "minimum": 0 }, "inputCommitment": { "$ref": "#/$defs/digest" }, "commitmentTrust": { "const": "unresolved" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "metrics": { "type": "object", "additionalProperties": false,
      "required": ["type-miss-rate", "wrong-family-rate", "wrong-jurisdiction-rate", "sensitive-miss-rate", "non-sensitive-flag-rate", "context-discrimination-rate", "benign-suppression-rate", "jurisdiction-collision-rate", "range-collateral-rate", "measurable-share"],
      "properties": {
        "type-miss-rate": { "$ref": "#/$defs/metric" }, "wrong-family-rate": { "$ref": "#/$defs/metric" },
        "wrong-jurisdiction-rate": { "$ref": "#/$defs/metric" }, "sensitive-miss-rate": { "$ref": "#/$defs/metric" },
        "non-sensitive-flag-rate": { "$ref": "#/$defs/metric" }, "context-discrimination-rate": { "$ref": "#/$defs/metric" },
        "benign-suppression-rate": { "$ref": "#/$defs/metric" }, "jurisdiction-collision-rate": { "$ref": "#/$defs/metric" },
        "range-collateral-rate": { "$ref": "#/$defs/metric" }, "measurable-share": { "$ref": "#/$defs/metric" }
      }
    },
    "benignByControlClass": { "type": "object", "additionalProperties": false,
      "required": ["reserved", "documentation", "test-value", "public-operational", "placeholder", "context-negative"],
      "properties": { "reserved": { "$ref": "#/$defs/metric" }, "documentation": { "$ref": "#/$defs/metric" },
        "test-value": { "$ref": "#/$defs/metric" }, "public-operational": { "$ref": "#/$defs/metric" },
        "placeholder": { "$ref": "#/$defs/metric" }, "context-negative": { "$ref": "#/$defs/metric" } }
    },
    "evidence": { "type": "object", "additionalProperties": false,
      "required": ["methods", "authority", "validators", "benign", "semanticControls", "context", "jurisdiction", "reference"],
      "properties": {
        "methods": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "authority": { "type": "object", "additionalProperties": false, "required": ["total", "qualified", "sources"],
          "properties": { "total": { "type": "integer", "minimum": 0 }, "qualified": { "type": "integer", "minimum": 0 }, "sources": { "type": "integer", "minimum": 0 } } },
        "validators": { "$ref": "#/$defs/applicable" },
        "benign": { "type": "object", "additionalProperties": false, "required": ["cases", "axes"],
          "properties": { "cases": { "type": "integer", "minimum": 0 }, "axes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/controlClass" } } } },
        "semanticControls": { "type": "integer", "minimum": 0 }, "context": { "$ref": "#/$defs/applicable" },
        "jurisdiction": { "$ref": "#/$defs/applicable" }, "reference": { "$ref": "#/$defs/applicableUnavailable" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableDigest": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "pii-v1" }, "version": { "const": 1 } } },
    "controlClass": { "enum": ["reserved", "documentation", "test-value", "public-operational", "placeholder", "context-negative"] },
    "claims": { "type": "array", "uniqueItems": true, "items": { "enum": ["format", "allocation", "context", "test-vector"] } },
    "source": { "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "engineVersion", "domain", "reportProfile", "evaluationProfile", "domainAccountingVersion", "runId", "startedAt", "finishedAt", "provenance", "scanner"],
      "properties": {
        "schemaVersion": { "const": 1 }, "engineVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "domain": { "const": "pii" },
        "reportProfile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "pii-evaluation" }, "version": { "const": 1 } } },
        "evaluationProfile": { "const": "pii-schema-v1" }, "domainAccountingVersion": { "const": "pii-observation-v1" },
        "runId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" }, "startedAt": { "type": "string" }, "finishedAt": { "type": "string" },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["sourceRevision", "candidateArtifactHash", "planHash"],
          "properties": { "sourceRevision": { "$ref": "#/$defs/nullableDigest" }, "candidateArtifactHash": { "$ref": "#/$defs/nullableDigest" }, "planHash": { "$ref": "#/$defs/nullableDigest" } } },
        "scanner": { "type": "object", "additionalProperties": false, "required": ["id", "version", "mode", "configurationHash", "status"],
          "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" }, "version": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$" }] },
            "mode": { "enum": ["candidate", "published", "holdout", "test", "unspecified"] }, "configurationHash": { "$ref": "#/$defs/digest" },
            "status": { "enum": ["complete", "unsupported", "unavailable", "error", "unstable"] } } }
      }
    },
    "scope": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "global" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "jurisdiction"], "properties": { "kind": { "const": "jurisdictional" }, "jurisdiction": { "$ref": "#/$defs/slug" } } }
    ] },
    "authority": { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "version", "claim", "observedAt"],
      "properties": { "kind": { "enum": ["standard", "public-authority", "official-test-source"] }, "locator": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }, "claim": { "enum": ["format", "allocation", "context", "test-vector"] }, "observedAt": { "type": "string" } } },
    "expectation": { "type": "object", "additionalProperties": false,
      "required": ["type", "sensitivity", "contextObligation", "contextClass", "validatorApplicable", "referenceApplicable"],
      "properties": { "type": { "enum": ["valid", "invalid"] }, "sensitivity": { "enum": ["sensitive", "non-sensitive", "unresolved"] },
        "contextObligation": { "enum": ["required", "optional", "forbidden"] }, "contextClass": { "enum": ["sensitive", "neutral", "non-sensitive"] },
        "validatorApplicable": { "type": "boolean" }, "referenceApplicable": { "type": "boolean" } } },
    "methodEvidence": { "type": "object", "additionalProperties": false, "required": ["controlClass", "validatorState", "collision", "referenceState"],
      "properties": { "controlClass": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/controlClass" }] },
        "validatorState": { "anyOf": [{ "type": "null" }, { "enum": ["valid", "invalid", "unavailable"] }] },
        "collision": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["targetFamily", "competingFamilies"],
          "properties": { "targetFamily": { "$ref": "#/$defs/slug" }, "competingFamilies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } } } }] },
        "referenceState": { "anyOf": [{ "type": "null" }, { "enum": ["valid", "invalid", "unavailable"] }] } } },
    "axis": { "type": "object", "additionalProperties": false, "required": ["axis", "status", "state", "reason"],
      "properties": { "axis": { "enum": ["type-identity", "sensitivity-context"] }, "status": { "enum": ["pass", "fail", "review-required", "not-measured"] },
        "state": { "enum": ["correct", "miss", "invalid-correct", "invalid-accepted", "wrong-family", "wrong-jurisdiction", "not-measured", "false-positive", "unresolved"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 160 } } },
    "outcome": { "type": "object", "additionalProperties": false, "required": ["scanner", "variant", "typeIdentity", "sensitivityContext", "range", "observed"],
      "properties": { "scanner": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" }, "variant": { "$ref": "#/$defs/slug" },
        "typeIdentity": { "$ref": "#/$defs/axis" }, "sensitivityContext": { "$ref": "#/$defs/axis" },
        "range": { "enum": ["exact", "overbroad", "partial", "miss", "not-applicable"] },
        "observed": { "type": "object", "additionalProperties": false, "required": ["findingCount", "families", "jurisdictions"],
          "properties": { "findingCount": { "type": "integer", "minimum": 0 }, "families": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
            "jurisdictions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } } } } } },
    "row": { "type": "object", "additionalProperties": false,
      "required": ["source", "caseId", "method", "family", "scope", "variant", "strategy", "scanner", "qualificationProfile", "authority", "expectation", "methodEvidence", "outcome"],
      "properties": { "source": { "$ref": "#/$defs/source" }, "caseId": { "$ref": "#/$defs/slug" }, "method": { "$ref": "#/$defs/slug" }, "family": { "$ref": "#/$defs/slug" },
        "scope": { "$ref": "#/$defs/scope" }, "variant": { "$ref": "#/$defs/slug" }, "strategy": { "enum": ["authored", "derived", "review-required"] },
        "scanner": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" }, "qualificationProfile": { "$ref": "#/$defs/profile" },
        "authority": { "$ref": "#/$defs/authority" }, "expectation": { "$ref": "#/$defs/expectation" }, "methodEvidence": { "$ref": "#/$defs/methodEvidence" }, "outcome": { "$ref": "#/$defs/outcome" } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["eligible", "measured", "numerator", "unresolved", "notMeasured", "notApplicable", "total"],
      "properties": { "eligible": { "type": "integer", "minimum": 0 }, "measured": { "type": "integer", "minimum": 0 }, "numerator": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 }, "notMeasured": { "type": "integer", "minimum": 0 }, "notApplicable": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } } },
    "rate": { "anyOf": [{ "type": "null" }, { "const": "insufficient-evidence" }, { "type": "object", "additionalProperties": false, "required": ["point", "bound", "n", "direction"],
      "properties": { "point": { "type": "number", "minimum": 0, "maximum": 1 }, "bound": { "type": "number", "minimum": 0, "maximum": 1 }, "n": { "type": "integer", "minimum": 1 }, "direction": { "enum": ["upper", "lower"] } } }] },
    "metric": { "type": "object", "additionalProperties": false, "required": ["population", "numerator", "denominator", "direction", "status", "counts", "effectiveN", "rate"],
      "properties": { "population": { "type": "string", "minLength": 1 }, "numerator": { "type": "string", "minLength": 1 }, "denominator": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["upper", "lower"] }, "status": { "enum": ["measured", "partial", "unresolved", "not-measured", "not-applicable"] }, "counts": { "$ref": "#/$defs/counts" },
        "effectiveN": { "type": "integer", "minimum": 0 }, "rate": { "$ref": "#/$defs/rate" } } },
    "applicable": { "type": "object", "additionalProperties": false, "required": ["applicable", "evaluated"], "properties": { "applicable": { "type": "integer", "minimum": 0 }, "evaluated": { "type": "integer", "minimum": 0 } } },
    "applicableUnavailable": { "type": "object", "additionalProperties": false, "required": ["applicable", "evaluated", "unavailable"], "properties": { "applicable": { "type": "integer", "minimum": 0 }, "evaluated": { "type": "integer", "minimum": 0 }, "unavailable": { "type": "integer", "minimum": 0 } } }
  }
}
