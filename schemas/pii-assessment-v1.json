{
  "$id": "urn:redact-secret:pii-assessment:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "category", "family", "displayName", "identityDomain", "scope", "qualificationProfile", "typeIdentity", "context", "sensitivity", "authority"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "$ref": "#/$defs/slug" },
    "category": { "const": "pii" },
    "family": { "$ref": "#/$defs/family" },
    "displayName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ()/.+-]{0,79}$" },
    "identityDomain": { "enum": ["email", "payment-card", "network-address", "iban", "phone", "national-id"] },
    "scope": { "enum": ["global","jurisdiction:AD","jurisdiction:AE","jurisdiction:AF","jurisdiction:AG","jurisdiction:AI","jurisdiction:AL","jurisdiction:AM","jurisdiction:AO","jurisdiction:AQ","jurisdiction:AR","jurisdiction:AS","jurisdiction:AT","jurisdiction:AU","jurisdiction:AW","jurisdiction:AX","jurisdiction:AZ","jurisdiction:BA","jurisdiction:BB","jurisdiction:BD","jurisdiction:BE","jurisdiction:BF","jurisdiction:BG","jurisdiction:BH","jurisdiction:BI","jurisdiction:BJ","jurisdiction:BL","jurisdiction:BM","jurisdiction:BN","jurisdiction:BO","jurisdiction:BQ","jurisdiction:BR","jurisdiction:BS","jurisdiction:BT","jurisdiction:BV","jurisdiction:BW","jurisdiction:BY","jurisdiction:BZ","jurisdiction:CA","jurisdiction:CC","jurisdiction:CD","jurisdiction:CF","jurisdiction:CG","jurisdiction:CH","jurisdiction:CI","jurisdiction:CK","jurisdiction:CL","jurisdiction:CM","jurisdiction:CN","jurisdiction:CO","jurisdiction:CR","jurisdiction:CU","jurisdiction:CV","jurisdiction:CW","jurisdiction:CX","jurisdiction:CY","jurisdiction:CZ","jurisdiction:DE","jurisdiction:DJ","jurisdiction:DK","jurisdiction:DM","jurisdiction:DO","jurisdiction:DZ","jurisdiction:EC","jurisdiction:EE","jurisdiction:EG","jurisdiction:EH","jurisdiction:ER","jurisdiction:ES","jurisdiction:ET","jurisdiction:FI","jurisdiction:FJ","jurisdiction:FK","jurisdiction:FM","jurisdiction:FO","jurisdiction:FR","jurisdiction:GA","jurisdiction:GB","jurisdiction:GD","jurisdiction:GE","jurisdiction:GF","jurisdiction:GG","jurisdiction:GH","jurisdiction:GI","jurisdiction:GL","jurisdiction:GM","jurisdiction:GN","jurisdiction:GP","jurisdiction:GQ","jurisdiction:GR","jurisdiction:GS","jurisdiction:GT","jurisdiction:GU","jurisdiction:GW","jurisdiction:GY","jurisdiction:HK","jurisdiction:HM","jurisdiction:HN","jurisdiction:HR","jurisdiction:HT","jurisdiction:HU","jurisdiction:ID","jurisdiction:IE","jurisdiction:IL","jurisdiction:IM","jurisdiction:IN","jurisdiction:IO","jurisdiction:IQ","jurisdiction:IR","jurisdiction:IS","jurisdiction:IT","jurisdiction:JE","jurisdiction:JM","jurisdiction:JO","jurisdiction:JP","jurisdiction:KE","jurisdiction:KG","jurisdiction:KH","jurisdiction:KI","jurisdiction:KM","jurisdiction:KN","jurisdiction:KP","jurisdiction:KR","jurisdiction:KW","jurisdiction:KY","jurisdiction:KZ","jurisdiction:LA","jurisdiction:LB","jurisdiction:LC","jurisdiction:LI","jurisdiction:LK","jurisdiction:LR","jurisdiction:LS","jurisdiction:LT","jurisdiction:LU","jurisdiction:LV","jurisdiction:LY","jurisdiction:MA","jurisdiction:MC","jurisdiction:MD","jurisdiction:ME","jurisdiction:MF","jurisdiction:MG","jurisdiction:MH","jurisdiction:MK","jurisdiction:ML","jurisdiction:MM","jurisdiction:MN","jurisdiction:MO","jurisdiction:MP","jurisdiction:MQ","jurisdiction:MR","jurisdiction:MS","jurisdiction:MT","jurisdiction:MU","jurisdiction:MV","jurisdiction:MW","jurisdiction:MX","jurisdiction:MY","jurisdiction:MZ","jurisdiction:NA","jurisdiction:NC","jurisdiction:NE","jurisdiction:NF","jurisdiction:NG","jurisdiction:NI","jurisdiction:NL","jurisdiction:NO","jurisdiction:NP","jurisdiction:NR","jurisdiction:NU","jurisdiction:NZ","jurisdiction:OM","jurisdiction:PA","jurisdiction:PE","jurisdiction:PF","jurisdiction:PG","jurisdiction:PH","jurisdiction:PK","jurisdiction:PL","jurisdiction:PM","jurisdiction:PN","jurisdiction:PR","jurisdiction:PS","jurisdiction:PT","jurisdiction:PW","jurisdiction:PY","jurisdiction:QA","jurisdiction:RE","jurisdiction:RO","jurisdiction:RS","jurisdiction:RU","jurisdiction:RW","jurisdiction:SA","jurisdiction:SB","jurisdiction:SC","jurisdiction:SD","jurisdiction:SE","jurisdiction:SG","jurisdiction:SH","jurisdiction:SI","jurisdiction:SJ","jurisdiction:SK","jurisdiction:SL","jurisdiction:SM","jurisdiction:SN","jurisdiction:SO","jurisdiction:SR","jurisdiction:SS","jurisdiction:ST","jurisdiction:SV","jurisdiction:SX","jurisdiction:SY","jurisdiction:SZ","jurisdiction:TC","jurisdiction:TD","jurisdiction:TF","jurisdiction:TG","jurisdiction:TH","jurisdiction:TJ","jurisdiction:TK","jurisdiction:TL","jurisdiction:TM","jurisdiction:TN","jurisdiction:TO","jurisdiction:TR","jurisdiction:TT","jurisdiction:TV","jurisdiction:TW","jurisdiction:TZ","jurisdiction:UA","jurisdiction:UG","jurisdiction:UM","jurisdiction:US","jurisdiction:UY","jurisdiction:UZ","jurisdiction:VA","jurisdiction:VC","jurisdiction:VE","jurisdiction:VG","jurisdiction:VI","jurisdiction:VN","jurisdiction:VU","jurisdiction:WF","jurisdiction:WS","jurisdiction:YE","jurisdiction:YT","jurisdiction:ZA","jurisdiction:ZM","jurisdiction:ZW"], "description": "ISO 3166-1 alpha-2 assignments pinned to ISO/TC 46 N1127 (2024-02-29)." },
    "qualificationProfile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "pii-v1" }, "version": { "const": 1 } } },
    "typeIdentity": { "type": "object", "additionalProperties": false, "required": ["state", "validator"], "properties": {
      "state": { "enum": ["valid", "invalid"] }, "validator": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/slug" }] }
    } },
    "context": { "type": "object", "additionalProperties": false, "required": ["obligation", "class", "language"], "properties": {
      "obligation": { "enum": ["none", "reinforcing", "required-for-sensitive-classification"] },
      "class": { "enum": ["sensitive", "neutral", "non-sensitive"] }, "language": { "$ref": "#/$defs/slug" }
    } },
    "sensitivity": { "enum": ["sensitive", "non-sensitive", "not-established"] },
    "authority": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authority" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "family": { "type": "string", "pattern": "^pii:(?:global|[a-z]{2}):[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "authority": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "sourceId", "locator", "revision", "supports"], "properties": {
      "sourceKind": { "enum": ["standard", "public-authority"] }, "sourceId": { "$ref": "#/$defs/slug" },
      "locator": { "type": "string", "minLength": 1, "maxLength": 200 }, "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
      "supports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lexical", "validation", "allocation", "reserved-control", "sensitivity"] } }
    } }
  }
}
