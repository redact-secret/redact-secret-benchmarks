{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarks.redactsecret.dev/schemas/pii-authority-v1.json",
  "title": "Which pipeline is the authority for PII measurement (#666)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "independence",
    "authorityModel",
    "protected",
    "legacy",
    "new",
    "exitCriteria"
  ],
  "properties": {
    "schema": {
      "const": "redact-secret/pii-authority/v1"
    },
    "authority": {
      "description": "The one value that flips PII authority. `legacy` is the committed default.",
      "enum": [
        "legacy",
        "new"
      ]
    },
    "independence": {
      "description": "States that a credential authority setting is not authorisation for PII.",
      "type": "string",
      "pattern": "[Cc]redential"
    },
    "authorityModel": {
      "description": "Who owns each class of PII authority (a role, not a readiness).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicSyntheticMeasurement",
        "productQualification",
        "protectedExecution",
        "privateAudit",
        "legacyEvaluator"
      ],
      "properties": {
        "publicSyntheticMeasurement": {
          "const": "pii-eval"
        },
        "productQualification": {
          "const": "benchmarks"
        },
        "protectedExecution": {
          "const": "private-custodian"
        },
        "privateAudit": {
          "const": "private-ledger"
        },
        "legacyEvaluator": {
          "const": "bounded-oracle-and-rollback"
        }
      }
    },
    "protected": {
      "description": "The protected path's own readiness. It never blocks the public/synthetic cutover.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "authority",
        "audit",
        "gate",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending-not-operational",
            "operational"
          ]
        },
        "authority": {
          "const": "private-custodian"
        },
        "audit": {
          "const": "private-ledger"
        },
        "gate": {
          "const": "protected-path-live"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "oracle"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 20
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exitCondition",
            "decision",
            "decidedBy",
            "reviewOn"
          ],
          "properties": {
            "exitCondition": {
              "type": "string",
              "minLength": 40
            },
            "decision": {
              "$ref": "#/$defs/decisionPath"
            },
            "decidedBy": {
              "type": "string",
              "minLength": 1
            },
            "reviewOn": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "new": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "authorisation"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "populations",
            "artifactSchema"
          ],
          "properties": {
            "engine": {
              "type": "string",
              "pattern": "^redact-secret/pii-eval@[0-9a-f]{40}$"
            },
            "populations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              }
            },
            "artifactSchema": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            }
          }
        },
        "authorisation": {
          "description": "Null until the owner accepts a measured verdict. Never written on the owner's behalf.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "release",
                "acceptedOn",
                "acceptedBy",
                "decision",
                "scope",
                "source",
                "engineCommit",
                "policyDigest",
                "populationDigests",
                "target"
              ],
              "properties": {
                "release": {
                  "type": "string",
                  "minLength": 1
                },
                "acceptedOn": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "acceptedBy": {
                  "type": "string",
                  "minLength": 1
                },
                "decision": {
                  "$ref": "#/$defs/decisionPath"
                },
                "engineCommit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "policyDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "populationDigests": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "scope": {
                  "const": "public-synthetic-measurement-authority"
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "description",
                    "answer",
                    "issueComment"
                  ],
                  "properties": {
                    "kind": {
                      "const": "owner-session"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "issueComment": {
                      "type": "string",
                      "pattern": "^https://github\\.com/redact-secret/redact-secret-benchmarks/issues/[0-9]+#issuecomment-[0-9]+$"
                    }
                  }
                },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "engineBinarySha256",
                    "scannerPackageTreeSha256",
                    "protocol",
                    "artifactSchema",
                    "manifestDigests",
                    "officialRunId"
                  ],
                  "properties": {
                    "engineBinarySha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "scannerPackageTreeSha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "protocol": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "revision"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "artifactSchema": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d+$"
                    },
                    "manifestDigests": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "officialRunId": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "exitCriteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "basis",
          "scope",
          "statement",
          "state",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "basis": {
            "enum": [
              "computed",
              "owner"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "state": {
            "enum": [
              "met",
              "unmet"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "public",
              "protected"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "decisionPath": {
      "type": "string",
      "pattern": "^(docs/decisions/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+\\.md|benchmarks/governance/authorisations/[0-9a-z-]+\\.json)$"
    }
  }
}
