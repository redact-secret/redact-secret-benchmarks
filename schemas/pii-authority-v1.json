{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarks.redactsecret.dev/schemas/pii-authority-v1.json",
  "title": "Which pipeline is the authority for PII measurement (#666)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "independence", "legacy", "new", "exitCriteria"],
  "properties": {
    "schema": { "const": "redact-secret/pii-authority/v1" },
    "authority": { "description": "The one value that flips PII authority. `legacy` is the committed default.", "enum": ["legacy", "new"] },
    "independence": { "description": "States that a credential authority setting is not authorisation for PII.", "type": "string", "pattern": "[Cc]redential" },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source", "oracle"],
      "properties": {
        "role": { "enum": ["authority", "oracle"] },
        "source": { "type": "string", "minLength": 20 },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exitCondition", "decision", "decidedBy", "reviewOn"],
          "properties": {
            "exitCondition": { "type": "string", "minLength": 40 },
            "decision": { "$ref": "#/$defs/decisionPath" },
            "decidedBy": { "type": "string", "minLength": 1 },
            "reviewOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    },
    "new": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "authorisation"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "populations", "artifactSchema"],
          "properties": {
            "engine": { "type": "string", "pattern": "^redact-secret/pii-eval@[0-9a-f]{40}$" },
            "populations": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
            "artifactSchema": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
          }
        },
        "authorisation": {
          "description": "Null until the owner accepts a measured verdict. Never written on the owner's behalf.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["release", "acceptedOn", "acceptedBy", "decision", "engineCommit", "policyDigest", "populationDigests"],
              "properties": {
                "release": { "type": "string", "minLength": 1 },
                "acceptedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "acceptedBy": { "type": "string", "minLength": 1 },
                "decision": { "$ref": "#/$defs/decisionPath" },
                "engineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "policyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "populationDigests": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
              }
            }
          ]
        }
      }
    },
    "exitCriteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "basis", "statement", "state", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "basis": { "enum": ["computed", "owner"] },
          "statement": { "type": "string", "minLength": 20 },
          "state": { "enum": ["met", "unmet"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "decisionPath": { "type": "string", "pattern": "^docs/decisions/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+\\.md$" }
  }
}
