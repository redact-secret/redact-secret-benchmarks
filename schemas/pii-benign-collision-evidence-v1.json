{
  "$id": "urn:redact-secret:pii-benign-collision-evidence:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "contentCommitment", "accountingProfile", "reporting", "classes", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "pii-benign-collision-v1" },
    "version": { "const": 1 },
    "contentCommitment": { "$ref": "#/$defs/digest" },
    "accountingProfile": { "type": "object", "additionalProperties": false, "required": ["id", "version", "benignAxes"],
      "properties": { "id": { "const": "pii-v1" }, "version": { "const": 1 }, "benignAxes": { "type": "array", "minItems": 6, "maxItems": 6,
        "uniqueItems": true, "items": { "$ref": "#/$defs/accountingAxis" } } } },
    "reporting": { "type": "object", "additionalProperties": false,
      "required": ["validatorCorrectness", "familyDiscrimination", "jurisdictionDiscrimination", "sensitivity"],
      "properties": { "validatorCorrectness": { "const": "evidence.validators" }, "familyDiscrimination": { "const": "metrics.wrong-family-rate" },
        "jurisdictionDiscrimination": { "const": "metrics.wrong-jurisdiction-rate" },
        "sensitivity": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["metrics.sensitive-miss-rate", "metrics.non-sensitive-flag-rate"] } } } },
    "classes": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/class" } },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "family": { "type": "string", "pattern": "^pii:(?:global|[a-z]{2}):[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,8}(?:-[a-z0-9]{2,8})*$" },
    "identityDomain": { "enum": ["email", "payment-card", "network-address", "iban", "phone", "national-id"] },
    "accountingAxis": { "enum": ["reserved", "documentation", "test-value", "public-operational", "placeholder", "context-negative"] },
    "evidenceClass": { "enum": ["reserved-documentation", "official-test", "public-operational", "ordinary-reference-account", "near-miss", "placeholder", "context-negative", "cross-family-collision"] },
    "class": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "accountingAxes", "qualifies"],
      "properties": { "id": { "$ref": "#/$defs/evidenceClass" }, "kind": { "enum": ["benign", "mechanical-control", "collision"] },
        "accountingAxes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/accountingAxis" } },
        "qualifies": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["type-identity", "validator", "sensitivity", "family-discrimination", "jurisdiction-discrimination"] } } } },
    "validatorExpectation": { "type": "object", "additionalProperties": false, "required": ["id", "version", "expected"],
      "properties": { "id": { "$ref": "#/$defs/slug" }, "version": { "type": "integer", "minimum": 1 },
        "expected": { "enum": ["valid", "invalid", "unavailable"] } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "sourceId", "locator", "revision"],
      "properties": { "sourceKind": { "enum": ["standard", "public-authority", "product-decision"] }, "sourceId": { "$ref": "#/$defs/slug" },
        "locator": { "type": "string", "pattern": "^https://" }, "revision": { "type": "string", "minLength": 1, "maxLength": 120 } } },
    "provenance": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "sources"], "properties": {
        "kind": { "const": "authoritative" }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "sources", "generator"], "properties": {
        "kind": { "const": "deterministic-synthetic" }, "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "generator": { "type": "object", "additionalProperties": false, "required": ["id", "version", "seedCommitment"],
          "properties": { "id": { "$ref": "#/$defs/slug" }, "version": { "type": "integer", "minimum": 1 }, "seedCommitment": { "$ref": "#/$defs/digest" } } } } }
    ] },
    "collisionParty": { "type": "object", "additionalProperties": false, "required": ["family", "jurisdiction", "validator"],
      "properties": { "family": { "$ref": "#/$defs/family" }, "jurisdiction": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Z]{2}$" }] },
        "validator": { "$ref": "#/$defs/validatorExpectation" } } },
    "collision": { "type": "object", "additionalProperties": false, "required": ["target", "competitors", "expectedOutcomes"],
      "properties": { "target": { "$ref": "#/$defs/collisionParty" }, "competitors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/collisionParty" } },
        "expectedOutcomes": { "type": "object", "additionalProperties": false, "required": ["family", "jurisdiction", "sensitivity"],
          "properties": { "family": { "enum": ["correct", "wrong-family"] }, "jurisdiction": { "enum": ["correct", "wrong-jurisdiction"] },
            "sensitivity": { "enum": ["sensitive", "non-sensitive", "not-established"] } } } } },
    "entry": { "type": "object", "additionalProperties": false,
      "required": ["id", "caseId", "evidenceClass", "accountingAxis", "family", "jurisdiction", "identityDomain", "language", "candidateCommitment", "typeExpectation", "sensitivityExpectation", "validator", "contextGroup", "collision", "provenance"],
      "properties": { "id": { "$ref": "#/$defs/slug" }, "caseId": { "$ref": "#/$defs/slug" }, "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "accountingAxis": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/accountingAxis" }] }, "family": { "$ref": "#/$defs/family" },
        "jurisdiction": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Z]{2}$" }] }, "identityDomain": { "$ref": "#/$defs/identityDomain" },
        "language": { "$ref": "#/$defs/language" }, "candidateCommitment": { "$ref": "#/$defs/digest" }, "typeExpectation": { "enum": ["valid", "invalid"] },
        "sensitivityExpectation": { "enum": ["sensitive", "non-sensitive", "not-established"] },
        "validator": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/validatorExpectation" }] },
        "contextGroup": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/slug" }] },
        "collision": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/collision" }] }, "provenance": { "$ref": "#/$defs/provenance" } }
    }
  }
}
