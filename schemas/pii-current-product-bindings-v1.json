{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "supportClaims",
    "source",
    "products",
    "bindings",
    "projectionCommitment"
  ],
  "properties": {
    "schema": {
      "const": "redact-secret/pii-current-product-bindings/v1"
    },
    "supportClaims": {
      "const": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "path",
        "sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "const": "benchmarks/pii-candidate-comparison/plan.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "sourceCommit",
          "coreSha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "baseline",
              "candidate"
            ]
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "coreSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceCommit",
          "coreSha256",
          "bindingCommitment",
          "binding"
        ],
        "properties": {
          "sourceCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "coreSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bindingCommitment": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "binding": {
            "type": "object"
          }
        }
      }
    },
    "projectionCommitment": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
