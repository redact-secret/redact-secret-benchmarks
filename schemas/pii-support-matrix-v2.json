{
  "$id": "urn:redact-secret:pii-support-matrix:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "supportClaims", "domain", "evaluationProfile", "domainAccountingVersion", "qualificationProfile", "registryCommitment", "activationContract", "populationReports", "populationComparisons", "distribution", "families", "artifactCommitment"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "reportType": { "const": "pii-support-matrix" },
    "supportClaims": { "const": false },
    "domain": { "const": "pii" },
    "evaluationProfile": { "const": "pii-v1" },
    "domainAccountingVersion": { "const": "pii-v1" },
    "qualificationProfile": { "$ref": "#/$defs/profile" },
    "registryCommitment": { "$ref": "#/$defs/digest" },
    "activationContract": { "type": "object", "additionalProperties": false, "required": ["repository", "decision", "mergeCommit", "productArtifact", "productSourceCommit", "productArtifactCommitment", "candidateEvidenceCommitment", "activationArtifactCommitment"], "properties": {
      "repository": { "const": "redact-secret/redact-secret" },
      "decision": { "const": "decision-define-the-pii-domain-scope-arbitration-and-activation-contract" },
      "mergeCommit": { "const": "eb22bdf587e0079e101fc3ab5aeefada58ba438d" },
      "productArtifact": { "enum": ["not-measured", "trusted"] },
      "productSourceCommit": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{40}$" }] },
      "productArtifactCommitment": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
      "candidateEvidenceCommitment": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
      "activationArtifactCommitment": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
    } },
    "populationReports": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/population" } },
    "populationComparisons": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/comparison" } },
    "distribution": { "type": "object", "additionalProperties": false, "required": ["pending", "provisional", "stable", "unsupported"], "properties": {
      "pending": { "type": "integer", "minimum": 0 }, "provisional": { "type": "integer", "minimum": 0 },
      "stable": { "type": "integer", "minimum": 0 }, "unsupported": { "type": "integer", "minimum": 0 }
    } },
    "protectedRoute": { "$ref": "#/$defs/protectedRoute" },
    "piiEvalMeasurement": { "$ref": "#/$defs/piiEvalMeasurement" },
    "custodianConformance": { "$ref": "#/$defs/custodianConformance" },
    "families": { "type": "array", "items": { "$ref": "#/$defs/familyRow" } },
    "artifactCommitment": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "custodianConformance": { "type": "object", "additionalProperties": false,
      "required": ["schema", "syntheticConformance", "supportClaims", "source", "bundleSha256", "candidateDigest", "configurationDigest", "configurationBinding", "destination", "feed", "projections", "qualification", "reason"], "properties": {
        "schema": { "const": "redact-secret-benchmarks.custodian-conformance/1" }, "syntheticConformance": { "const": true }, "supportClaims": { "const": false },
        "source": { "type": "object", "additionalProperties": false, "required": ["repository", "commit"], "properties": {
          "repository": { "const": "redact-secret/private-custodian" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" } } },
        "bundleSha256": { "$ref": "#/$defs/digest" }, "candidateDigest": { "$ref": "#/$defs/custodianDigest" },
        "configurationDigest": { "$ref": "#/$defs/custodianDigest" }, "configurationBinding": { "const": "bridge-request-only-not-signed-projection" },
        "destination": { "$ref": "#/$defs/slug" },
        "feed": { "type": "object", "additionalProperties": false, "required": ["feedId", "sequence", "freshUntil"], "properties": {
          "feedId": { "type": "string", "pattern": "^fed_[a-z0-9]{16,64}$" }, "sequence": { "type": "integer", "minimum": 1 },
          "freshUntil": { "type": "integer", "minimum": 0 } } },
        "projections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/custodianProjection" } },
        "qualification": { "const": "not-live-support-evidence" },
        "reason": { "const": "synthetic-signature-conformance-is-not-independent-ground-truth" }
      } },
    "custodianProjection": { "type": "object", "additionalProperties": false,
      "required": ["digest", "projectionId", "receiptId", "population", "policy", "standing", "destinationBinding", "attestation", "cells"], "properties": {
        "digest": { "$ref": "#/$defs/custodianDigest" }, "projectionId": { "type": "string", "pattern": "^prj_[a-z0-9]{16,64}$" },
        "receiptId": { "type": "string", "pattern": "^rcp_[a-z0-9]{16,64}$" }, "population": { "$ref": "#/$defs/custodianPopulation" },
        "policy": { "$ref": "#/$defs/custodianPolicy" }, "standing": { "const": "valid" }, "destinationBinding": { "const": "destination-bound" },
        "attestation": { "$ref": "#/$defs/custodianAttestation" }, "cells": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/custodianCell" } }
      } },
    "custodianDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "custodianPopulation": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "opaque" }, "id": { "type": "string", "pattern": "^ppr_[a-z0-9]{16,64}$" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "key_id", "commitment"], "properties": { "kind": { "const": "keyed" }, "key_id": { "type": "string", "pattern": "^key_[a-z0-9]{16,64}$" }, "commitment": { "type": "string", "pattern": "^hmac-sha256:[a-f0-9]{64}$" } } }
    ] },
    "custodianPolicy": { "type": "object", "additionalProperties": false, "required": ["domain", "kind", "name", "version"], "properties": {
      "domain": { "const": "pii" }, "kind": { "const": "disclosure" }, "name": { "$ref": "#/$defs/slug" }, "version": { "type": "integer", "minimum": 1 } } },
    "custodianAttestation": { "type": "object", "additionalProperties": false,
      "required": ["independence", "role_separation", "organisational_independence", "authorship", "review", "ground_truth"], "properties": {
        "independence": { "enum": ["public-control", "custodian-declared", "procedural-separation"] },
        "role_separation": { "enum": ["single_operator_procedural", "distinct_principals"] }, "organisational_independence": { "const": "not_claimed" },
        "authorship": { "enum": ["project_authored", "external_authored"] }, "review": { "enum": ["project_reviewed", "external_reviewed"] },
        "ground_truth": { "const": "not_established" }
      } },
    "custodianCell": { "type": "object", "additionalProperties": false, "required": ["metric", "stratum", "value"], "properties": {
      "metric": { "$ref": "#/$defs/slug" }, "stratum": { "$ref": "#/$defs/slug" }, "value": { "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "suppressed" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "numerator", "denominator"], "properties": { "state": { "const": "reported" }, "numerator": { "type": "integer", "minimum": 0 }, "denominator": { "type": "integer", "minimum": 0 } } }
      ] } } },
    "piiEvalMeasurement": { "type": "object", "additionalProperties": false,
      "required": ["schema", "complete", "decision", "pooling", "build", "populations", "rejections"], "properties": {
        "schema": { "const": "pii-eval-consumer-report/1" }, "complete": { "const": true }, "decision": { "const": "none" }, "pooling": { "const": "none" },
        "rejections": { "type": "array", "maxItems": 0 },
        "build": { "type": "object", "additionalProperties": false,
          "required": ["repository", "commit", "cargoLockSha256", "binarySha256", "sourceArchiveSha256", "binding"], "properties": {
            "repository": { "const": "redact-secret/pii-eval" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "cargoLockSha256": { "$ref": "#/$defs/digest" }, "binarySha256": { "$ref": "#/$defs/digest" },
            "sourceArchiveSha256": { "$ref": "#/$defs/digest" }, "binding": { "const": "out-of-band-build-provenance" }
          } },
        "populations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/piiEvalPopulation" } },
        "quantityBasis": { "type": "object", "additionalProperties": false, "required": ["decision", "protocol", "verdictReads", "thresholdsApplied", "definitions"], "properties": {
          "decision": { "type": "string", "pattern": "^docs/decisions/[a-z0-9-]+\\.md$" }, "protocol": { "const": "pii-v1" }, "verdictReads": { "const": "b11" }, "thresholdsApplied": { "const": false },
          "definitions": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "object", "additionalProperties": false,
            "required": ["quantity", "id", "name", "owner", "population", "numerator", "denominator"], "properties": {
              "quantity": { "type": "string", "pattern": "^pii-v1:[a-z-]+$" }, "id": { "type": "string", "pattern": "^[a-z-]+$" }, "name": { "type": "string", "minLength": 1 }, "owner": { "const": "pii-eval" },
              "population": { "type": "string", "minLength": 1 }, "numerator": { "type": "string", "minLength": 1 }, "denominator": { "type": "string", "minLength": 1 } } } } } }
      } },
    "piiEvalPopulation": { "type": "object", "additionalProperties": false,
      "required": ["label", "populationId", "artifactDigest", "file", "status", "schemaVersion", "population", "populationCounts", "productBinding", "scanners"],
      "oneOf": [
        { "required": ["unavailable"], "properties": { "schemaVersion": { "const": "1.1" }, "unavailable": true, "productProjection": false } },
        { "required": ["productProjection"], "properties": { "schemaVersion": { "enum": ["1.2", "1.4"] }, "productProjection": true, "unavailable": false } }
      ],
      "properties": {
        "schemaVersion": { "enum": ["1.1", "1.2", "1.4"] },
        "productBinding": { "type": "object", "additionalProperties": false, "required": ["state", "candidateSourceCommit"], "properties": {
          "state": { "enum": ["measures-publication-product", "other-product", "publication-product-not-measured"] },
          "candidateSourceCommit": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{40}$" }] } } },
        "productProjection": { "$ref": "#/$defs/piiEvalProjection" },
        "label": { "$ref": "#/$defs/slug" }, "populationId": { "type": "string", "minLength": 1, "maxLength": 128 }, "artifactDigest": { "$ref": "#/$defs/digest" },
        "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$" }, "status": { "const": "accepted" },
        "population": { "type": "object", "additionalProperties": false, "required": ["populationId", "populationVersion", "populationDigest", "visibility"], "properties": {
          "populationId": { "type": "string", "minLength": 1, "maxLength": 128 }, "populationVersion": { "type": "integer", "minimum": 1 },
          "populationDigest": { "$ref": "#/$defs/digest" }, "visibility": { "const": "public-synthetic" } } },
        "populationCounts": { "type": "object", "additionalProperties": false, "required": ["authoredCases", "variants", "occurrences"], "properties": {
          "authoredCases": { "type": "integer", "minimum": 0 }, "variants": { "type": "integer", "minimum": 0 }, "occurrences": { "type": "integer", "minimum": 0 } } },
        "scanners": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
          "required": ["scannerId", "status", "identity", "metrics"], "properties": { "scannerId": { "type": "string", "minLength": 1 }, "status": { "const": "complete" },
            "identity": { "type": "object" }, "metrics": { "type": "array", "minItems": 10, "maxItems": 10 } } } },
        "unavailable": { "type": "object", "additionalProperties": false,
          "required": ["familyProjection", "populationViews", "languageBreakdown", "controlClassBreakdown", "officialOrExploratoryMode"], "properties": {
            "familyProjection": { "const": "schema-1.1-does-not-carry" }, "populationViews": { "const": "schema-1.1-does-not-carry" },
            "languageBreakdown": { "const": "schema-1.1-does-not-carry" }, "controlClassBreakdown": { "const": "schema-1.1-does-not-carry" },
            "officialOrExploratoryMode": { "const": "schema-1.1-does-not-carry" } } }
      } },
    "piiEvalView": { "enum": ["benign-heavy-stress", "diagnostic-balanced", "oracle-plan", "qualification-plan"] },
    "piiEvalCounts": { "type": "object", "additionalProperties": false, "required": ["authoredCases", "occurrences", "variants"], "properties": {
      "authoredCases": { "type": "integer", "minimum": 0 }, "occurrences": { "type": "integer", "minimum": 0 }, "variants": { "type": "integer", "minimum": 0 } } },
    "piiEvalMetrics": { "type": "array", "minItems": 10, "maxItems": 10 },
    "piiEvalStratum": { "type": "object", "additionalProperties": false, "required": ["counts", "metrics"], "properties": {
      "counts": { "$ref": "#/$defs/piiEvalCounts" }, "metrics": { "$ref": "#/$defs/piiEvalMetrics" }, "language": { "type": "string", "minLength": 2, "maxLength": 35 },
      "controlClass": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" } } },
    "piiEvalProjection": { "type": "object", "additionalProperties": false, "required": ["requiredViews", "rosterDigest", "rows"], "properties": {
      "requiredViews": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/piiEvalView" } },
      "rosterDigest": { "$ref": "#/$defs/digest" },
      "rows": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false,
        "required": ["family", "view", "mode", "binding", "counts", "methodCoverage", "metrics"], "properties": {
          "family": { "type": "string", "pattern": "^pii:(global|[a-z]{2}):[a-z0-9]+(-[a-z0-9]+)*$" }, "view": { "$ref": "#/$defs/piiEvalView" }, "mode": { "enum": ["exploratory", "official"] },
          "binding": { "type": "object", "additionalProperties": false, "required": ["scannerId", "configurationDigest", "activationDigest", "product", "population"], "properties": {
            "scannerId": { "type": "string", "minLength": 1 }, "configurationDigest": { "$ref": "#/$defs/digest" }, "activationDigest": { "$ref": "#/$defs/digest" },
            "product": { "type": "object" }, "population": { "type": "object" } } },
          "counts": { "$ref": "#/$defs/piiEvalCounts" },
          "methodCoverage": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["method", "cases", "variants"], "properties": {
            "method": { "type": "object" }, "cases": { "type": "integer", "minimum": 0 }, "variants": { "type": "integer", "minimum": 0 } } } },
          "metrics": { "$ref": "#/$defs/piiEvalMetrics" },
          "byLanguage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/piiEvalStratum" } },
          "byControlClass": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/piiEvalStratum" } } } } } } },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repoFile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,199}$" },
    "protectedRoute": { "type": "object", "additionalProperties": false,
      "required": ["id", "route", "issue", "productIssue", "record", "evidenceDirectory", "sealRecord", "maximumStatus", "coreCommit", "freezeCommitment", "reportCommitment", "dispositionCommitment", "sealCommitment", "costAcceptance", "artifactCommitment", "families"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" }, "route": { "const": "pii-b11-protected-v1" },
        "issue": { "type": "string", "pattern": "^redact-secret/[a-z0-9-]+#[0-9]+$" }, "productIssue": { "type": "string", "pattern": "^redact-secret/[a-z0-9-]+#[0-9]+$" },
        "record": { "$ref": "#/$defs/repoFile" }, "evidenceDirectory": { "$ref": "#/$defs/repoFile" }, "sealRecord": { "$ref": "#/$defs/repoFile" },
        "maximumStatus": { "const": "provisional" }, "coreCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "freezeCommitment": { "$ref": "#/$defs/digest" }, "reportCommitment": { "$ref": "#/$defs/digest" }, "dispositionCommitment": { "$ref": "#/$defs/digest" },
        "sealCommitment": { "$ref": "#/$defs/digest" }, "artifactCommitment": { "$ref": "#/$defs/digest" },
        "costAcceptance": { "type": "object", "additionalProperties": false, "required": ["id", "entryCommitment"], "properties": {
          "id": { "$ref": "#/$defs/slug" }, "entryCommitment": { "$ref": "#/$defs/digest" } } },
        "families": { "type": "array", "items": { "type": "object", "additionalProperties": false,
          "required": ["family", "status", "reason", "epochCommitment", "aggregateCommitment", "trustCommitment", "coverage"], "properties": {
            "family": { "$ref": "#/$defs/family" }, "status": { "enum": ["pending", "provisional"] },
            "reason": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}(?::[a-z][a-z0-9-]{1,79}(?:,[a-z][a-z0-9-]{1,79})*)?$" },
            "epochCommitment": { "$ref": "#/$defs/digest" }, "aggregateCommitment": { "$ref": "#/$defs/digest" }, "trustCommitment": { "$ref": "#/$defs/digest" },
            "coverage": { "type": "object", "additionalProperties": false, "required": ["scope", "jurisdiction", "restriction", "note", "contract", "contractSha256"], "properties": {
              "scope": { "$ref": "#/$defs/scope" }, "jurisdiction": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
              "restriction": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/slug" }] },
              "note": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ()/.,+-]{0,119}$" },
              "contract": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/repoFile" }] },
              "contractSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] } } } } } }
      } },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "family": { "type": "string", "pattern": "^pii:(?:global|[a-z]{2}):[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "scope": { "type": "string", "pattern": "^(?:global|jurisdiction:[A-Z]{2})$" },
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "pii-v1" }, "version": { "const": 1 } } },
    "populationFamily": { "type": "object", "additionalProperties": false, "required": ["family", "status", "strata"], "properties": {
      "family": { "$ref": "#/$defs/family" }, "status": { "enum": ["measured", "partial", "not-measured", "not-applicable"] },
      "strata": { "type": "integer", "minimum": 0 }
    } },
    "population": { "type": "object", "additionalProperties": false, "required": ["id", "status", "contractCommitment", "corpusCommitment", "reportCommitment", "familyEvidence"], "properties": {
      "id": { "enum": ["diagnostic-balanced", "benign-heavy-stress"] }, "status": { "enum": ["measured", "partial", "not-measured"] },
      "contractCommitment": { "$ref": "#/$defs/digest" }, "corpusCommitment": { "$ref": "#/$defs/digest" }, "reportCommitment": { "$ref": "#/$defs/digest" },
      "familyEvidence": { "type": "array", "items": { "$ref": "#/$defs/populationFamily" } }
    } },
    "comparisonIdentity": { "type": "object", "additionalProperties": false, "required": ["reportCommitment", "candidateArtifactHash"], "properties": {
      "reportCommitment": { "$ref": "#/$defs/digest" }, "candidateArtifactHash": { "$ref": "#/$defs/digest" }
    } },
    "benignDelta": { "type": "object", "additionalProperties": false,
      "required": ["family", "scope", "contextClass", "evidenceClass", "accountingAxis", "validatorBacked", "contextDependent", "baselineRate", "candidateRate", "delta", "limit", "regressed"], "properties": {
        "family": { "$ref": "#/$defs/family" }, "scope": { "$ref": "#/$defs/scope" }, "contextClass": { "enum": ["sensitive", "neutral", "non-sensitive"] },
        "evidenceClass": { "enum": ["reserved-documentation", "official-test", "public-identifier", "ordinary-reference-account", "near-miss", "placeholder", "context-negative", "cross-family-collision"] },
        "accountingAxis": { "anyOf": [{ "type": "null" }, { "enum": ["reserved", "documentation", "test-value", "public-operational", "placeholder", "context-negative"] }] },
        "validatorBacked": { "type": "boolean" }, "contextDependent": { "type": "boolean" },
        "baselineRate": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }] },
        "candidateRate": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }] },
        "delta": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": -1, "maximum": 1 }] },
        "limit": { "type": "number", "minimum": 0, "maximum": 1 }, "regressed": { "type": "boolean" }
      } },
    "diagnosticDelta": { "type": "object", "additionalProperties": false,
      "required": ["axis", "applicable", "baselineRate", "candidateRate", "delta", "baselineFailed", "candidateFailed", "failedDelta", "regressed"], "properties": {
        "axis": { "enum": ["type-identity", "validator-correctness", "context-discrimination"] }, "applicable": { "type": "boolean" },
        "baselineRate": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }] },
        "candidateRate": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }] },
        "delta": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": -1, "maximum": 1 }] },
        "baselineFailed": { "type": "integer", "minimum": 0 }, "candidateFailed": { "type": "integer", "minimum": 0 },
        "failedDelta": { "type": "integer" }, "regressed": { "type": "boolean" }
      } },
    "comparison": { "type": "object", "additionalProperties": false,
      "required": ["id", "status", "contractCommitment", "corpusCommitment", "baselineObservation", "candidateObservation", "verdict", "benignFalseAlarmDeltas", "diagnosticDeltas"], "properties": {
        "id": { "enum": ["diagnostic-balanced", "benign-heavy-stress"] }, "status": { "enum": ["not-measured", "compared"] },
        "contractCommitment": { "$ref": "#/$defs/digest" }, "corpusCommitment": { "$ref": "#/$defs/digest" },
        "baselineObservation": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/comparisonIdentity" }] },
        "candidateObservation": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/comparisonIdentity" }] },
        "verdict": { "enum": ["not-measured", "no-regression", "regression"] },
        "benignFalseAlarmDeltas": { "type": "array", "items": { "$ref": "#/$defs/benignDelta" } },
        "diagnosticDeltas": { "type": "array", "items": { "$ref": "#/$defs/diagnosticDelta" } }
      } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "sourceId", "locator", "revision", "supports"], "properties": {
      "sourceKind": { "enum": ["standard", "public-authority"] }, "sourceId": { "$ref": "#/$defs/slug" },
      "locator": { "type": "string", "minLength": 1, "maxLength": 200 }, "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
      "supports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lexical", "validation", "allocation", "reserved-control", "sensitivity"] } }
    } },
    "activation": { "type": "object", "additionalProperties": false, "required": ["state", "selector", "activationIdentity", "productArtifactCommitment"], "properties": {
      "state": { "enum": ["not-measured", "unavailable", "available", "explicitly-unsupported"] },
      "selector": { "type": "string", "pattern": "^pii:family:(?:global|[a-z]{2}):[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "activationIdentity": { "type": ["string", "null"], "pattern": "^credentials=(?:full|common);selectors=[a-z0-9:,-]+;families=pii:[a-z0-9:,-]+;vocabulary=[a-z0-9@._/-]+$" },
      "productArtifactCommitment": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
    } },
    "familyPopulation": { "type": "object", "additionalProperties": false, "required": ["id", "reportStatus", "status", "strata", "reportCommitment"], "properties": {
      "id": { "enum": ["diagnostic-balanced", "benign-heavy-stress"] }, "status": { "enum": ["measured", "partial", "not-measured", "not-applicable"] },
      "reportStatus": { "enum": ["measured", "partial", "not-measured"] },
      "strata": { "type": "integer", "minimum": 0 }, "reportCommitment": { "$ref": "#/$defs/digest" }
    } },
    "status": { "type": "object", "additionalProperties": false, "required": ["state", "profile", "reasonCodes"], "properties": {
      "state": { "enum": ["pending", "provisional", "stable", "unsupported"] }, "profile": { "$ref": "#/$defs/profile" },
      "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" } }
    } },
    "familyRow": { "type": "object", "additionalProperties": false,
      "required": ["family", "displayName", "identityDomain", "familyContractVersion", "scope", "jurisdiction", "qualificationProfile", "authority", "contextObligation", "validatorApplicable", "activation", "status", "populationEvidence", "qualificationArtifactCommitment"],
      "properties": {
        "family": { "$ref": "#/$defs/family" }, "displayName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ()/.+-]{0,79}$" },
        "identityDomain": { "enum": ["email", "payment-card", "network-address", "iban", "phone", "national-id"] },
        "familyContractVersion": { "type": "integer", "minimum": 1 }, "scope": { "$ref": "#/$defs/scope" },
        "jurisdiction": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" }, "qualificationProfile": { "$ref": "#/$defs/profile" },
        "authority": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authority" } },
        "contextObligation": { "enum": ["none", "reinforcing", "required-for-sensitive-classification"] }, "validatorApplicable": { "type": "boolean" },
        "activation": { "$ref": "#/$defs/activation" }, "status": { "$ref": "#/$defs/status" },
        "populationEvidence": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/familyPopulation" } },
        "qualificationArtifactCommitment": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
      }
    }
  }
}
