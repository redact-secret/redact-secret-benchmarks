{
  "$id": "urn:redact-secret:pii-support-registry:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "contentCommitment", "source", "families"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "pii-support-registry-v1" }, "version": { "const": 1 },
    "contentCommitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["repository", "decision", "mergeCommit"], "properties": {
      "repository": { "const": "redact-secret/redact-secret" },
      "decision": { "const": "decision-define-pii-v1-qualification-and-national-id-arrival-gates" },
      "mergeCommit": { "const": "eb22bdf587e0079e101fc3ab5aeefada58ba438d" }
    } },
    "families": { "type": "array", "items": { "$ref": "#/$defs/family" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "authority": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "sourceId", "locator", "revision", "supports"], "properties": {
      "sourceKind": { "enum": ["standard", "public-authority"] }, "sourceId": { "$ref": "#/$defs/slug" },
      "locator": { "type": "string", "minLength": 1, "maxLength": 200 }, "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
      "supports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lexical", "validation", "allocation", "reserved-control", "sensitivity"] } }
    } },
    "family": { "type": "object", "additionalProperties": false,
      "required": ["family", "displayName", "identityDomain", "familyContractVersion", "scope", "jurisdiction", "qualificationProfile", "authority", "contextObligation", "validatorApplicable"],
      "properties": {
        "family": { "type": "string", "pattern": "^pii:(?:global|[a-z]{2}):[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "displayName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ()/.+-]{0,79}$" },
        "identityDomain": { "enum": ["email", "payment-card", "network-address", "iban", "phone", "national-id"] },
        "familyContractVersion": { "type": "integer", "minimum": 1 }, "scope": { "type": "string", "pattern": "^(?:global|jurisdiction:[A-Z]{2})$" },
        "jurisdiction": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "qualificationProfile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "pii-v1" }, "version": { "const": 1 } } },
        "authority": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authority" } },
        "contextObligation": { "enum": ["none", "reinforcing", "required-for-sensitive-classification"] }, "validatorApplicable": { "type": "boolean" }
      }
    }
  }
}
