{
  "$id": "urn:redact-secret:pii-validator-observation:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "producer", "contractUnderTest", "targets", "observations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportType": { "const": "pii-validator-simulation" },
    "producer": { "type": "object", "additionalProperties": false, "required": ["kind", "repository"], "properties": {
      "kind": { "const": "benchmark-simulation" }, "repository": { "const": "redact-secret/redact-secret-benchmarks" }
    } },
    "contractUnderTest": { "type": "object", "additionalProperties": false, "required": ["repository", "commit", "conformanceSurface"], "properties": {
      "repository": { "const": "redact-secret/redact-secret" }, "commit": { "$ref": "#/$defs/digest40" },
      "conformanceSurface": { "const": "unavailable" }
    } },
    "targets": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "adapterHash"], "properties": { "id": { "enum": ["native", "wasm"] }, "adapterHash": { "$ref": "#/$defs/digest64" } } } },
    "observations": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
      "required": ["target", "validator", "vectorId", "outcome"], "properties": {
        "target": { "enum": ["native", "wasm"] },
        "validator": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {
          "id": { "$ref": "#/$defs/slug" }, "version": { "type": "integer", "minimum": 1 }
        } },
        "vectorId": { "$ref": "#/$defs/slug" },
        "outcome": { "enum": ["valid", "candidate-too-long", "malformed", "checksum-mismatch", "unknown-validator", "unavailable"] }
      } }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "digest40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest64": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
