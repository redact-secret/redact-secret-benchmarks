{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:policy-qualified-credential:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "qualificationProfile", "evidenceTier", "evidenceBasis", "publicLabel", "criteria", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "credential-policy-v1" },
    "qualificationProfile": { "const": "policy-qualified" },
    "evidenceTier": { "const": "T3" },
    "evidenceBasis": { "const": "project-policy" },
    "publicLabel": { "const": "Stable · Policy qualified" },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumPositiveCases", "minimumPositiveAxes", "minimumBenignCases", "minimumBenignAxes", "minimumTwinPairs", "exactSpanMisses", "leakedSpans", "overbroadSpans", "collateralBytes", "redactFalseAlarms", "blockFalseAlarms", "unexpectedPositiveActions", "unresolvedActionCases", "unresolvedCriticalFailures", "requirePublicConformance", "requireProtectedHoldout", "rationale"],
      "properties": {
        "minimumPositiveCases": { "type": "integer", "minimum": 1 }, "minimumPositiveAxes": { "type": "integer", "minimum": 1 },
        "minimumBenignCases": { "type": "integer", "minimum": 1 }, "minimumBenignAxes": { "type": "integer", "minimum": 1 },
        "minimumTwinPairs": { "type": "integer", "minimum": 1 }, "exactSpanMisses": { "const": 0 }, "leakedSpans": { "const": 0 },
        "overbroadSpans": { "const": 0 }, "collateralBytes": { "const": 0 }, "redactFalseAlarms": { "const": 0 },
        "blockFalseAlarms": { "const": 0 }, "unexpectedPositiveActions": { "const": 0 }, "unresolvedActionCases": { "const": 0 },
        "unresolvedCriticalFailures": { "const": 0 }, "requirePublicConformance": { "const": true }, "requireProtectedHoldout": { "const": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "families": {
      "type": "object", "additionalProperties": false,
      "required": ["bearer-token", "connection-string", "otpauth-uri", "generic-token"],
      "properties": {
        "bearer-token": { "$ref": "#/definitions/contract" }, "connection-string": { "$ref": "#/definitions/contract" },
        "otpauth-uri": { "$ref": "#/definitions/contract" }, "generic-token": { "$ref": "#/definitions/contract" }
      }
    }
  },
  "definitions": {
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["taxonomyFamily", "trigger", "candidate", "exactSpan", "requiredAction", "exclusions", "blindSpots", "externalFacts", "projectPolicy"],
      "properties": {
        "taxonomyFamily": { "type": "string", "pattern": "^generic:" }, "trigger": { "type": "string", "minLength": 1 },
        "candidate": { "type": "string", "minLength": 1 }, "exactSpan": { "type": "string", "minLength": 1 },
        "requiredAction": { "enum": ["redact", "fixture-resolved"] },
        "allowedActions": { "type": "array", "uniqueItems": true, "items": { "enum": ["warn", "redact", "block", "allow"] } },
        "actionResolution": { "type": "string", "minLength": 1 },
        "exclusions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "blindSpots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "externalFacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "projectPolicy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [{
        "if": { "properties": { "requiredAction": { "const": "fixture-resolved" } }, "required": ["requiredAction"] },
        "then": { "properties": { "allowedActions": true, "actionResolution": true }, "required": ["allowedActions", "actionResolution"] }
      }]
    }
  }
}
