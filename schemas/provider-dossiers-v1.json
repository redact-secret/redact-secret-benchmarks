{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:provider-dossiers:1",
  "title": "Provider dossiers roadmap (#478)",
  "description": "Generated by benchmarks/generate-provider-dossiers.ts and published as public/results/provider-dossiers-v1.json. Only the research verdict, tier, blockedBy, researchedAt and links come from a dossier; every stage flag, the stage and the support status are derived. It carries counts and ids only, never a fixture value, and no field holds a forecast or a date the work is expected to land.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taxonomySchemaVersion", "supportMatrix", "providerCount", "familyCount", "stageDistribution", "verdictDistribution", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taxonomySchemaVersion": { "const": 1 },
    "supportMatrix": {
      "description": "Which evidence run the measured status was read from; null when the file was generated without a support matrix, in which case no family reaches the measured stage.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "generatedAt", "revision"],
          "properties": {
            "runId": { "type": "string", "minLength": 1 },
            "generatedAt": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "providerCount": { "type": "integer", "minimum": 0 },
    "familyCount": { "type": "integer", "minimum": 0 },
    "stageDistribution": {
      "description": "Families whose furthest reached stage is each key, in stage order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["researched", "in-taxonomy", "benchmarked", "core-detector", "measured"],
      "properties": {
        "researched": { "type": "integer", "minimum": 0 },
        "in-taxonomy": { "type": "integer", "minimum": 0 },
        "benchmarked": { "type": "integer", "minimum": 0 },
        "core-detector": { "type": "integer", "minimum": 0 },
        "measured": { "type": "integer", "minimum": 0 }
      }
    },
    "verdictDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresearched", "ready", "issuance-gated", "date-gated", "not-found", "rejected"],
      "properties": {
        "unresearched": { "type": "integer", "minimum": 0 },
        "ready": { "type": "integer", "minimum": 0 },
        "issuance-gated": { "type": "integer", "minimum": 0 },
        "date-gated": { "type": "integer", "minimum": 0 },
        "not-found": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "families"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "families": { "type": "array", "items": { "$ref": "#/definitions/family" } }
        }
      }
    }
  },
  "definitions": {
    "stage": { "enum": ["researched", "in-taxonomy", "benchmarked", "core-detector", "measured"] },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "name", "verdict", "tier", "researchedAt", "blockedBy", "issues", "sources", "evidence", "detectors", "reached", "stage", "supportStatus", "fixtureGaps"],
      "properties": {
        "family": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["unresearched", "ready", "issuance-gated", "date-gated", "not-found", "rejected"] },
        "tier": { "enum": [null, "T0", "T1", "T2", "T3"] },
        "researchedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "blockedBy": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "url"],
            "properties": {
              "ref": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*$" },
              "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$" }
            }
          }
        },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://[^\\s]+$" } },
        "evidence": { "type": ["string", "null"], "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(blob|tree)/[0-9a-f]{40}/[^\\s]+$" },
        "detectors": { "description": "Detector or arrival-family ids mapped in taxonomy.json.", "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reached": {
          "description": "Derived. researched: the dossier records a verdict. in-taxonomy: always true here. benchmarked: every mapped detector has a fixture-profile row that meets the stable floors. core-detector: every mapped detector is in benchmarks/detectors.json. measured: the support matrix reads stable or provisional.",
          "type": "object",
          "additionalProperties": false,
          "required": ["researched", "in-taxonomy", "benchmarked", "core-detector", "measured"],
          "properties": {
            "researched": { "type": "boolean" },
            "in-taxonomy": { "type": "boolean" },
            "benchmarked": { "type": "boolean" },
            "core-detector": { "type": "boolean" },
            "measured": { "type": "boolean" }
          }
        },
        "stage": { "description": "Derived: the furthest stage reached. A researched family nothing has been built for reads researched; an unresearched one reads in-taxonomy.", "$ref": "#/definitions/stage" },
        "supportStatus": { "enum": [null, "stable", "provisional", "pending", "unsupported"] },
        "fixtureGaps": {
          "description": "Fixture cells still short of the stable floors, as counts.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["detector", "cell", "actual", "required"],
            "properties": {
              "detector": { "type": "string", "minLength": 1 },
              "cell": { "type": "string", "minLength": 1 },
              "actual": { "type": "integer", "minimum": 0 },
              "required": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
