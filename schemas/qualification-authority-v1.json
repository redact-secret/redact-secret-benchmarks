{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarks.redactsecret.dev/schemas/qualification-authority-v1.json",
  "title": "Which pipeline is the authority for credential qualification (#608)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "legacy", "new"],
  "properties": {
    "schema": { "const": "redact-secret/qualification-authority/v1" },
    "authority": {
      "description": "The one value that flips authority. `legacy` is the committed default; `new` reads the qualification view derived from the official credential-eval runs.",
      "enum": ["legacy", "new"]
    },
    "legacy": {
      "description": "The legacy pipeline's standing while the other one is the authority: kept intact, as the oracle, for a bounded period.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "oracle"],
      "properties": {
        "role": { "enum": ["authority", "oracle"] },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exitCondition", "decision"],
          "properties": {
            "exitCondition": { "type": "string", "minLength": 20 },
            "decision": { "$ref": "#/$defs/decisionPath" },
            "exit": {
              "description": "The recorded oracle exit (#660): the owner's decision that the exit condition holds. A record, not a switch: it does not change `authority` and removes nothing by itself.",
              "type": "object",
              "additionalProperties": false,
              "required": ["recordedOn", "recordedBy", "release", "parityReport", "rollbackRehearsal", "callerInventory", "decision"],
              "properties": {
                "recordedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "recordedBy": { "type": "string", "minLength": 1 },
                "release": { "type": "string", "pattern": "^@[a-z0-9-]+/[a-z0-9-]+@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
                "parityReport": { "$ref": "#/$defs/reportPath" },
                "rollbackRehearsal": { "type": "string", "pattern": "^docs/[A-Za-z0-9/._-]+\\.md#[a-z0-9-]+$" },
                "callerInventory": { "const": "npm run legacy-inventory:check" },
                "decision": { "$ref": "#/$defs/decisionPath" }
              }
            }
          }
        }
      }
    },
    "new": {
      "description": "What the new path is authorised for. Consulted only while `authority` is `new`: a repin, a new official run or a policy change makes it stale, and the check then fails until the new view is authorised again. Rolling back to `legacy` leaves it in place.",
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "acceptedOn", "acceptedBy", "policyRevision", "semanticDigests", "parityReport", "decision"],
      "properties": {
        "release": { "type": "string", "pattern": "^@[a-z0-9-]+/[a-z0-9-]+@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
        "acceptedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "acceptedBy": { "type": "string", "minLength": 1 },
        "policyRevision": { "type": "string", "pattern": "^rs-policy-\\d+:sha256:[0-9a-f]{64}$" },
        "semanticDigests": {
          "description": "The canonical linux-x64 run of every population (and the methods run, `<population>+methods`) the view is built from, by run id without the platform.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9-]+(\\+methods)?$" },
          "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "parityReport": { "$ref": "#/$defs/reportPath" },
        "decision": { "$ref": "#/$defs/decisionPath" }
      }
    }
  },
  "$defs": {
    "decisionPath": { "type": "string", "pattern": "^docs/decisions/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+\\.md$" },
    "reportPath": { "type": "string", "pattern": "^docs/generated/[a-z0-9-]+\\.json$" }
  }
}
