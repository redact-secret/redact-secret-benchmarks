{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarks.redactsecret.dev/schemas/qualification-view-v1.json",
  "title": "Redact Secret qualification view v1",
  "description": "Deterministic output of the RunArtifact to qualification adapter (#605, docs/specs/qualification-adapter.md). One view cites one artifact per population; counts stay per population and are never pooled. Status is computed here by the benchmark-owned rules; credential-eval never emits one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter",
    "publication",
    "policy",
    "populations",
    "scanners",
    "distribution",
    "stableDistribution",
    "families",
    "undetected",
    "knownGaps",
    "unmappedFamilies"
  ],
  "properties": {
    "schema": {
      "const": "redact-secret/qualification-view/v1"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "publication": {
      "enum": [
        "public",
        "internal"
      ],
      "description": "public only when every contributing artifact is publication public and its population is publishable."
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "components",
        "scanner",
        "populations",
        "methodsRequired",
        "criteria",
        "fixtureProfilesVersion",
        "rules",
        "differentialPeers",
        "attributionFallback",
        "axisCoverage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^rs-policy-[0-9]+:sha256:[0-9a-f]{64}$",
          "description": "The product policy revision stamp: SHA-256 over the adapter identity and one digest per benchmark-owned qualification input."
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "scanner": {
          "type": "string"
        },
        "populations": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "floors-and-gates",
              "gates",
              "policy-route"
            ]
          }
        },
        "methodsRequired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "object",
          "description": "benchmarks/support/status-criteria.json as applied."
        },
        "fixtureProfilesVersion": {
          "type": "integer"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "axisOverlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "population",
            "corpusDigest",
            "contexts",
            "controls",
            "detectors"
          ],
          "description": "The product-owned axis overlay the floors were counted with (benchmarks/support/public-axis-overlay.json); its digest is a policy component.",
          "properties": {
            "id": {
              "type": "string"
            },
            "population": {
              "type": "string"
            },
            "corpusDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "contexts": {
              "type": "integer",
              "minimum": 0
            },
            "controls": {
              "type": "integer",
              "minimum": 0
            },
            "detectors": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "differentialPeers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The peer scanners whose differential occurrences the gate reads (population-policy.json methods.differential.peers). Other peers are measured and reported (families[].differential), never gate-bearing."
        },
        "attributionFallback": {
          "type": "array",
          "items": {
            "enum": [
              "overlay-detectors",
              "twin-parent"
            ]
          },
          "description": "How a case the snapshot attributes to no product detector is attributed, in order (population-policy.json attribution.fallback)."
        },
        "ledgerRekey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "population",
            "corpusDigest",
            "occurrences"
          ],
          "description": "The legacy review-ledger decisions mapped to canonical occurrence ids (benchmarks/support/public-review-ledger-map.json); its digest is a policy component.",
          "properties": {
            "id": {
              "type": "string"
            },
            "population": {
              "type": "string"
            },
            "corpusDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "occurrences": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "axisCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "populations"
          ],
          "description": "The populations whose axis labels are unioned into a family axis floor (benchmarks/support/population-policy.json axisCoverage). Counts are never summed.",
          "properties": {
            "populations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "twinScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "population",
            "scopedBy",
            "corpusDigest",
            "twins"
          ],
          "description": "The twin-scope map: public twins the snapshot gives no family, gated through the project case that carries them with their parent family (benchmarks/support/public-twin-scope-map.json); its digest is a policy component.",
          "properties": {
            "id": {
              "type": "string"
            },
            "population": {
              "type": "string"
            },
            "scopedBy": {
              "type": "string"
            },
            "corpusDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "twins": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "populations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "population",
          "role",
          "denominator",
          "runClass",
          "artifact",
          "unattributed",
          "aggregates",
          "cases"
        ],
        "properties": {
          "population": {
            "type": "string"
          },
          "role": {
            "enum": [
              "floors-and-gates",
              "gates",
              "policy-route"
            ]
          },
          "denominator": {
            "type": "string",
            "description": "Equal to the population id: one denominator per population."
          },
          "runClass": {
            "enum": [
              "public",
              "internal"
            ]
          },
          "artifact": {
            "$ref": "#/$defs/artifactIdentity"
          },
          "methodsArtifact": {
            "$ref": "#/$defs/artifactIdentity",
            "description": "The methods run of the floors population: a second official artifact over the same evidence whose cases are generated variants. Absent when no methods run was made."
          },
          "unattributed": {
            "type": "array",
            "description": "Counts of cases that map to no product detector family, per scanner.",
            "items": {
              "$ref": "#/$defs/scannerCounts"
            }
          },
          "aggregates": {
            "type": "array",
            "description": "The engine's published aggregates, verbatim (withheld figures stay withheld); never recomputed here.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scanner",
                "status",
                "groups",
                "byTarget"
              ],
              "properties": {
                "scanner": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "groups": {
                  "type": "object"
                },
                "byTarget": {
                  "type": "object"
                }
              }
            }
          },
          "cases": {
            "type": "array",
            "description": "Every case of the population with each scanner's own measurement, sorted by id (#606). Additive within v1: no count or status above is derived from it; it feeds the Next case pages only.",
            "items": {
              "$ref": "#/$defs/caseRow"
            }
          }
        }
      }
    },
    "scanners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "distribution": {
      "$ref": "#/$defs/distribution"
    },
    "stableDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documented",
        "empirical",
        "policy-qualified"
      ],
      "properties": {
        "documented": {
          "type": "integer"
        },
        "empirical": {
          "type": "integer"
        },
        "policy-qualified": {
          "type": "integer"
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "taxonomyFamilies",
          "contract",
          "status",
          "evidence",
          "fixtureProfile",
          "gates",
          "populations",
          "differential",
          "attribution",
          "axisCoverage"
        ],
        "properties": {
          "family": {
            "type": "string",
            "description": "A product detector family."
          },
          "taxonomyFamilies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "provider",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "contract": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "tier",
              "providerSource",
              "unprobeable",
              "supportedContext"
            ],
            "properties": {
              "tier": {
                "enum": [
                  "T0",
                  "T1",
                  "T2",
                  "T3"
                ]
              },
              "providerSource": {
                "type": "boolean"
              },
              "unprobeable": {},
              "supportedContext": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "reasons",
              "qualificationProfile",
              "evidenceTier",
              "evidenceBasis",
              "methodsNotRun"
            ],
            "properties": {
              "value": {
                "enum": [
                  "stable",
                  "provisional",
                  "pending",
                  "unsupported"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Empty only when stable."
              },
              "qualificationProfile": {
                "enum": [
                  "documented",
                  "empirical",
                  "policy-qualified",
                  null
                ]
              },
              "evidenceTier": {
                "enum": [
                  "T0",
                  "T1",
                  "T2",
                  "T3",
                  null
                ]
              },
              "evidenceBasis": {
                "enum": [
                  "provider-documented",
                  "independently-corroborated",
                  "empirically-observed",
                  "project-policy",
                  "none"
                ]
              },
              "methodsNotRun": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "evidence": {
            "type": "object",
            "description": "FamilySupportEvidence (benchmarks/support/status.ts) as derived from the artifacts.",
            "required": [
              "family",
              "detectors",
              "positiveContractTier",
              "twinPairs",
              "twinFailures",
              "benignCases",
              "benignFalseAlarms",
              "benignAxes",
              "benignAxisIds",
              "positiveCases",
              "positiveAxes",
              "totalFixtures",
              "policyQualification"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "policyQualification": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "failedGates"
                ],
                "properties": {
                  "failedGates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "code",
                        "actual",
                        "required"
                      ],
                      "properties": {
                        "code": {},
                        "actual": {},
                        "required": {}
                      }
                    }
                  }
                }
              },
              "detectors": {},
              "positiveContractTier": {},
              "twinPairs": {},
              "twinFailures": {},
              "benignCases": {},
              "benignFalseAlarms": {},
              "benignAxes": {},
              "benignAxisIds": {},
              "positiveCases": {},
              "positiveAxes": {},
              "totalFixtures": {}
            }
          },
          "fixtureProfile": {
            "type": "object",
            "required": [
              "profilesVersion",
              "target",
              "cells",
              "requiredCells",
              "debt"
            ],
            "properties": {
              "profilesVersion": {},
              "target": {},
              "cells": {},
              "requiredCells": {},
              "debt": {}
            }
          },
          "gates": {
            "type": "array",
            "description": "The zero-tolerance gate inputs of each gate-bearing population, side by side. Never summed.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "population",
                "twinPairs",
                "twinFailures",
                "benignCases",
                "benignFalseAlarms",
                "twinPairsScopedElsewhere",
                "twinFailuresScopedElsewhere"
              ],
              "properties": {
                "population": {
                  "type": "string"
                },
                "twinPairs": {
                  "type": "integer"
                },
                "twinFailures": {
                  "type": "integer"
                },
                "benignCases": {
                  "type": "integer"
                },
                "benignFalseAlarms": {
                  "type": "integer"
                },
                "twinPairsScopedElsewhere": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Twin pairs of this population the twin-scope map takes out of its gate because a project population measures them with the parent family."
                },
                "twinFailuresScopedElsewhere": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Of those, the pairs the engine read as not discriminating in this population. Reported, not gate-bearing."
                }
              }
            }
          },
          "populations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "population",
                "role",
                "scanners"
              ],
              "properties": {
                "population": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "floors-and-gates",
                    "gates",
                    "policy-route"
                  ]
                },
                "scanners": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/scannerCounts"
                  }
                }
              }
            }
          },
          "differential": {
            "description": "The differential review occurrences of the methods run attributed to the family, per peer. Only gate-bearing peers count toward the stable gate; null when the methods run did not run differential.",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "gatePeers",
                  "peers"
                ],
                "properties": {
                  "gatePeers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "peers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "peer",
                        "gateBearing",
                        "occurrences",
                        "settled",
                        "unresolved"
                      ],
                      "properties": {
                        "peer": {
                          "type": "string"
                        },
                        "gateBearing": {
                          "type": "boolean"
                        },
                        "occurrences": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "settled": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "unresolved": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "attribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "snapshot",
              "overlay-detectors",
              "twin-parent"
            ],
            "description": "How the floors population cases of the family were attributed to it: by what the snapshot names, by the overlay legacy targets, or through the twin parent.",
            "properties": {
              "snapshot": {
                "type": "integer",
                "minimum": 0
              },
              "overlay-detectors": {
                "type": "integer",
                "minimum": 0
              },
              "twin-parent": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "axisCoverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "positiveContext",
              "control",
              "confusion"
            ],
            "description": "The axes the family floors were judged on, each with the populations that supplied it. Coverage is the union of labels across the policy axisCoverage populations; counts are never summed.",
            "properties": {
              "positiveContext": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "axis",
                    "populations"
                  ],
                  "properties": {
                    "axis": {
                      "type": "string"
                    },
                    "populations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "control": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "axis",
                    "populations"
                  ],
                  "properties": {
                    "axis": {
                      "type": "string"
                    },
                    "populations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "confusion": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "axis",
                    "populations"
                  ],
                  "properties": {
                    "axis": {
                      "type": "string"
                    },
                    "populations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "undetected": {
      "type": "array",
      "description": "Taxonomy families with no detector: representable, undetected.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "name",
          "supportStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "supportStatus": {
            "enum": [
              "pending",
              "unsupported",
              null
            ]
          }
        }
      }
    },
    "knownGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "kind",
          "number",
          "fixtures"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixture",
                "matches"
              ],
              "properties": {
                "fixture": {
                  "type": "string"
                },
                "matches": {
                  "type": "array",
                  "description": "Cases with this id, per population; empty when the id does not exist in a population (a re-key, #607).",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "population",
                      "measurement",
                      "outcomes",
                      "flagged"
                    ],
                    "properties": {
                      "population": {
                        "type": "string"
                      },
                      "measurement": {
                        "enum": [
                          "positive",
                          "control",
                          "pending",
                          "not-measured"
                        ]
                      },
                      "outcomes": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "enum": [
                            "EXACT",
                            "COVERED",
                            "OVERBROAD",
                            "PARTIAL",
                            "MISS"
                          ]
                        }
                      },
                      "flagged": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "unmappedFamilies": {
      "type": "array",
      "description": "population:family pairs the artifact names that no product detector family serves.",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable",
        "provisional",
        "pending",
        "unsupported"
      ],
      "properties": {
        "stable": {
          "type": "integer"
        },
        "provisional": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "unsupported": {
          "type": "integer"
        }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactDigest",
        "semanticDigest",
        "schema",
        "engine",
        "protocolVersion",
        "configHash",
        "evidence",
        "engineRunClass",
        "publication",
        "methods",
        "caseCount",
        "scanners"
      ],
      "properties": {
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semanticDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema": {
          "const": "credential-eval/run-artifact/v1"
        },
        "engine": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {},
            "version": {}
          }
        },
        "protocolVersion": {
          "type": "string"
        },
        "configHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "object",
          "required": [
            "source",
            "revision",
            "evidence_schema",
            "corpus_digest"
          ],
          "properties": {
            "source": {},
            "revision": {},
            "evidence_schema": {},
            "corpus_digest": {}
          }
        },
        "engineRunClass": {
          "enum": [
            "official",
            "exploratory"
          ]
        },
        "publication": {
          "enum": [
            "public",
            "internal"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caseCount": {
          "type": "integer"
        },
        "scanners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "mode",
              "build",
              "adapter",
              "configurationHash",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mode": {
                "type": "string"
              },
              "build": {
                "enum": [
                  "released",
                  "candidate",
                  null
                ]
              },
              "adapter": {
                "type": "object",
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {},
                  "version": {}
                }
              },
              "configurationHash": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scannerCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanner",
        "counts"
      ],
      "properties": {
        "scanner": {
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "positive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "spans",
        "outcomes",
        "leakedSpans",
        "leakedBytes",
        "collateralBytes"
      ],
      "properties": {
        "cases": {
          "type": "integer"
        },
        "spans": {
          "type": "integer"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "EXACT",
            "COVERED",
            "OVERBROAD",
            "PARTIAL",
            "MISS"
          ],
          "properties": {
            "EXACT": {
              "type": "integer"
            },
            "COVERED": {
              "type": "integer"
            },
            "OVERBROAD": {
              "type": "integer"
            },
            "PARTIAL": {
              "type": "integer"
            },
            "MISS": {
              "type": "integer"
            }
          }
        },
        "leakedSpans": {
          "type": "integer"
        },
        "leakedBytes": {
          "type": "integer"
        },
        "collateralBytes": {
          "type": "integer"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "pending",
        "notMeasured",
        "positives",
        "benign",
        "twins"
      ],
      "properties": {
        "cases": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "notMeasured": {
          "type": "integer"
        },
        "positives": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "must-redact",
            "policy"
          ],
          "properties": {
            "must-redact": {
              "$ref": "#/$defs/positive"
            },
            "policy": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "benign": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "flagged",
            "findings"
          ],
          "properties": {
            "cases": {
              "type": "integer"
            },
            "flagged": {
              "type": "integer"
            },
            "findings": {
              "type": "integer"
            }
          }
        },
        "twins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pairs",
            "discriminated",
            "flagged",
            "coDetected"
          ],
          "properties": {
            "pairs": {
              "type": "integer"
            },
            "discriminated": {
              "type": "integer"
            },
            "flagged": {
              "type": "integer"
            },
            "coDetected": {
              "type": "integer"
            }
          }
        }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "One scanner's measurement of one case as the RunArtifact recorded it. A field that does not apply to the measurement is absent. A pending case and a case that was not measured are their own words, never a miss and never a pass.",
      "required": [
        "scanner",
        "measurement",
        "observed"
      ],
      "properties": {
        "scanner": {
          "type": "string"
        },
        "measurement": {
          "enum": [
            "positive",
            "control",
            "pending",
            "not-measured"
          ]
        },
        "outcomes": {
          "type": "array",
          "items": {
            "enum": [
              "EXACT",
              "COVERED",
              "OVERBROAD",
              "PARTIAL",
              "MISS"
            ]
          },
          "description": "A positive case: one outcome per expected span. Absent for other measurements."
        },
        "leakedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "collateralBytes": {
          "type": "integer",
          "minimum": 0
        },
        "flagged": {
          "type": "boolean",
          "description": "A control only: whether the scanner flagged it."
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "coDetected": {
          "type": "boolean"
        },
        "observed": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings the scanner reported on the case."
        },
        "status": {
          "type": "string",
          "description": "A case that was not measured: the scanner status that prevented the measurement, as the artifact names it."
        }
      }
    },
    "caseRow": {
      "type": "object",
      "additionalProperties": false,
      "description": "One corpus case of a population (#606), keyed by (population, id). Evidence class is the artifact's own label and never a support status; detectors and attribution are the adapter's product attribution. No case content is carried.",
      "required": [
        "id",
        "path",
        "kind",
        "tier",
        "group",
        "family",
        "taxonomy",
        "evidenceClass",
        "targets",
        "twinOf",
        "twinMutationKind",
        "detectors",
        "attribution",
        "expected",
        "results"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "The case's path inside the population's corpus."
        },
        "kind": {
          "enum": [
            "must-redact",
            "must-not-flag",
            "policy"
          ]
        },
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3"
          ]
        },
        "group": {
          "type": "string"
        },
        "family": {
          "type": [
            "string",
            "null"
          ],
          "description": "The family the corpus names (a taxonomy family or a detector id), not the product family."
        },
        "taxonomy": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "twinOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "twinMutationKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "detectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The product detector families the case counts under; empty for an unattributed case."
        },
        "attribution": {
          "enum": [
            "snapshot",
            "overlay-detectors",
            "twin-parent",
            "none"
          ]
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "role"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "type": "string"
              },
              "envelope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "description": "The span of the surrounding assignment or block, when the corpus records one."
              }
            }
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseResult"
          },
          "description": "One entry per scanner that ran the population."
        }
      }
    }
  }
}
