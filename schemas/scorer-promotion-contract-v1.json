{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/redact-secret/redact-secret-benchmarks/schemas/scorer-promotion-contract-v1.json",
  "title": "Statistical scorer future-promotion qualification contract v1",
  "description": "The hard constraints a future release must meet before the statistical evidence scorer may change default Confidence or action (#257). Structural contract only; the question coverage, required dimensions, non-negotiable bounds, secrecy and publication rules and the content hash are enforced by benchmarks/lib/scorer-promotion.ts. See docs/specs/scorer-promotion-gates.md. The contract states gate bounds only: never scorer weights, caps, band cut-offs or candidate-level detail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "contractVersion", "status", "issue", "parent", "spec", "decision", "productContract", "scope", "framing", "principles", "beta9", "publication", "identity", "evasionAggregate", "questions", "gates", "revisions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "const": "scorer-promotion-gates" },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["proposed", "accepted"] },
    "issue": { "$ref": "#/definitions/githubIssue" },
    "parent": { "$ref": "#/definitions/githubIssue" },
    "spec": { "type": "string", "pattern": "^docs/specs/[a-z0-9-]+\\.md$" },
    "decision": { "type": "string", "pattern": "^decision-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "productContract": { "const": "decision-freeze-the-shadow-evidence-score-and-confidence-contract" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detectors", "scoredSpecificities", "invariantSpecificities", "comparison"],
      "properties": {
        "detectors": { "$ref": "#/definitions/slugList" },
        "scoredSpecificities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["contextual", "entropy"] } },
        "invariantSpecificities": { "type": "array", "uniqueItems": true, "items": { "enum": ["private-key", "provider", "structural"] } },
        "comparison": { "$ref": "#/definitions/text" }
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "mixedScore", "objective", "constraints"],
      "properties": {
        "method": { "const": "constrained-optimisation" },
        "mixedScore": { "const": false },
        "objective": { "$ref": "#/definitions/text" },
        "constraints": { "$ref": "#/definitions/text" }
      }
    },
    "principles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attackerKnowsScorer", "securityDependsOnSecrecy", "promotionDependsOnSecretValues", "newModelIdentityRequired", "newCandidateIdentityRequired", "evidenceCarriedAcrossIdentities"],
      "properties": {
        "attackerKnowsScorer": { "const": true },
        "securityDependsOnSecrecy": { "const": false },
        "promotionDependsOnSecretValues": { "const": false },
        "newModelIdentityRequired": { "const": true },
        "newCandidateIdentityRequired": { "const": true },
        "evidenceCarriedAcrossIdentities": { "const": false }
      }
    },
    "beta9": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcementPromotion", "passesWithoutQuestion5", "statement"],
      "properties": {
        "enforcementPromotion": { "const": false },
        "passesWithoutQuestion5": { "const": true },
        "statement": { "$ref": "#/definitions/text" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "never", "minimumPublishedStratumRows"],
      "properties": {
        "public": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
        "never": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
        "minimumPublishedStratumRows": { "type": "integer", "minimum": 5 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "rule"],
      "properties": {
        "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "rule": { "$ref": "#/definitions/text" }
      }
    },
    "evasionAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "schema", "reportType", "requiredAttackClasses", "minimumVariantsPerClass", "countFields", "invariantFields"],
      "properties": {
        "issue": { "$ref": "#/definitions/githubIssue" },
        "schema": { "const": "schemas/score-evasion-aggregate-v1.json" },
        "reportType": { "const": "score-evasion-aggregate" },
        "requiredAttackClasses": { "$ref": "#/definitions/slugList" },
        "minimumVariantsPerClass": { "type": "integer", "minimum": 5 },
        "countFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" } },
        "invariantFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" } }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "beta9Role", "population"],
        "properties": {
          "id": { "enum": ["Q1", "Q2", "Q3", "Q4", "Q5"] },
          "question": { "$ref": "#/definitions/text" },
          "beta9Role": { "enum": ["informational", "not-required"] },
          "population": { "$ref": "#/definitions/text" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "dimension", "metric", "kind", "source", "visibility", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[1-5]-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "question": { "enum": ["Q1", "Q2", "Q3", "Q4", "Q5"] },
          "dimension": {
            "enum": ["coherence", "calibration", "twin-discrimination", "false-alarm", "leaked-span", "collateral", "invariance", "unstable", "unreviewed", "measurable-share", "evasion", "negative-evidence-abuse", "identity", "governance", "protected-holdout", "runtime", "performance", "size"]
          },
          "metric": { "type": "string", "pattern": "^[a-z][A-Za-z]*\\.[a-z][A-Za-z]*$" },
          "kind": { "enum": ["boolean", "absolute", "delta", "member"] },
          "operator": { "enum": ["==", "<=", ">="] },
          "bound": { "type": ["number", "boolean"] },
          "allowed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" } },
          "strata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimensions", "minimumSupport"],
            "properties": {
              "dimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" } },
              "operator": { "enum": ["==", "<=", ">="] },
              "bound": { "type": "number" },
              "minimumSupport": { "type": "integer", "minimum": 0 },
              "required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
            }
          },
          "source": { "type": "string", "pattern": "^https://github\\.com/redact-secret/redact-secret(?:-benchmarks)?/issues/[1-9][0-9]*$" },
          "visibility": { "enum": ["public", "verdict-only"] },
          "rationale": { "$ref": "#/definitions/text" }
        }
      }
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "date", "summary", "contentHash"],
        "properties": {
          "contractVersion": { "type": "integer", "minimum": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "summary": { "$ref": "#/definitions/text" },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "githubIssue": { "type": "string", "pattern": "^https://github\\.com/redact-secret/redact-secret(?:-benchmarks)?/issues/[1-9][0-9]*$" },
    "slugList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" } }
  }
}
