{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:support-status-criteria:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stable", "provisional", "pending", "unsupported"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documented", "empirical", "twinFailures", "benign", "metamorphic", "mutation", "differential"],
      "properties": {
        "documented": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "requireProviderSource", "minimumPositiveCases", "minimumPositiveAxes", "minimumBenignCases", "minimumControlAxes", "minimumTwinPairs", "rationale"],
          "properties": {
            "tier": { "const": "T1" },
            "requireProviderSource": { "const": true },
            "minimumPositiveCases": { "$ref": "#/definitions/threshold" },
            "minimumPositiveAxes": { "$ref": "#/definitions/threshold" },
            "minimumBenignCases": { "$ref": "#/definitions/threshold" },
            "minimumControlAxes": { "$ref": "#/definitions/threshold" },
            "minimumTwinPairs": { "$ref": "#/definitions/threshold" },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "empirical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "minimumObservations", "minimumSubjects", "minimumIssuanceDates", "minimumCorroborationClasses", "corroborated", "unresolvedContradictions", "minimumPositiveCases", "minimumPositiveAxes", "minimumBenignCases", "minimumControlAxes", "minimumTwinPairs", "contextConstrained", "rationale"],
          "properties": {
            "tier": { "const": "T2" },
            "minimumObservations": { "$ref": "#/definitions/threshold" },
            "minimumSubjects": { "$ref": "#/definitions/threshold" },
            "minimumIssuanceDates": { "$ref": "#/definitions/threshold" },
            "minimumCorroborationClasses": { "$ref": "#/definitions/threshold" },
            "corroborated": {
              "type": "object", "additionalProperties": false,
              "required": ["minimumReferences", "minimumOwners", "minimumClasses", "summaryClasses", "rationale"],
              "properties": {
                "minimumReferences": { "$ref": "#/definitions/threshold" },
                "minimumOwners": { "$ref": "#/definitions/threshold" },
                "minimumClasses": { "$ref": "#/definitions/threshold" },
                "summaryClasses": {
                  "type": "object", "additionalProperties": false, "required": ["classes", "rationale"],
                  "properties": {
                    "classes": { "type": "array", "uniqueItems": true, "items": { "enum": ["peer-scanner-rule", "provider-owned-code", "provider-example", "independent-implementation", "independent-research"] } },
                    "rationale": { "type": "string", "minLength": 1 }
                  }
                },
                "rationale": { "type": "string", "minLength": 1 }
              }
            },
            "unresolvedContradictions": { "$ref": "#/definitions/threshold" },
            "minimumPositiveCases": { "$ref": "#/definitions/threshold" },
            "minimumPositiveAxes": { "$ref": "#/definitions/threshold" },
            "minimumBenignCases": { "$ref": "#/definitions/threshold" },
            "minimumControlAxes": { "$ref": "#/definitions/threshold" },
            "minimumTwinPairs": { "$ref": "#/definitions/threshold" },
            "contextConstrained": {
              "type": "object", "additionalProperties": false,
              "required": ["minimumContextTwinPairs", "minimumConfusionAxes", "minimumFixtures"],
              "properties": {
                "minimumContextTwinPairs": { "$ref": "#/definitions/threshold" },
                "minimumConfusionAxes": { "$ref": "#/definitions/threshold" },
                "minimumFixtures": { "$ref": "#/definitions/threshold" }
              }
            },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "twinFailures": { "$ref": "#/definitions/threshold" },
        "benign": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumCases", "minimumAxes", "falseAlarms"],
          "properties": {
            "minimumCases": { "$ref": "#/definitions/threshold" },
            "minimumAxes": { "$ref": "#/definitions/threshold" },
            "falseAlarms": { "$ref": "#/definitions/threshold" }
          }
        },
        "metamorphic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criticalFailures"],
          "properties": { "criticalFailures": { "$ref": "#/definitions/threshold" } }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unresolvedCritical"],
          "properties": { "unresolvedCritical": { "$ref": "#/definitions/threshold" } }
        },
        "differential": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unresolvedContractDisagreements"],
          "properties": { "unresolvedContractDisagreements": { "$ref": "#/definitions/threshold" } }
        }
      }
    },
    "provisional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresDetector", "rationale"],
      "properties": {
        "requiresDetector": { "const": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "rationale"],
      "properties": {
        "tier": { "const": "T0" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresReason", "rationale"],
      "properties": {
        "requiresReason": { "const": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
