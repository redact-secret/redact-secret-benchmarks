{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:support-status-report:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "runId", "revision", "dirty", "criteriaSchemaVersion", "fixtureProfilesVersion", "product", "scanners", "caseCount", "variantCount", "familyCount", "distribution", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "runId": { "type": "string" },
    "revision": { "type": "string" },
    "dirty": { "type": ["boolean", "null"] },
    "criteriaSchemaVersion": { "const": 1 },
    "fixtureProfilesVersion": { "type": "integer", "minimum": 1 },
    "product": {
      "type": ["object", "null"],
      "description": "Null when this run measured the pinned published package, the default. Populated when a candidate build substituted the redact-secret entry, naming the exact build the report describes so it can never be mistaken for one about a different build.",
      "additionalProperties": false,
      "required": ["sourceCommit", "packageName", "declaredVersion", "artifacts"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "packageName": { "type": "string", "minLength": 1 },
        "declaredVersion": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "sha256"],
            "properties": {
              "role": { "enum": ["package", "node", "wasm"] },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "scanners": { "type": "array", "items": { "type": "string" } },
    "caseCount": { "type": "integer", "minimum": 0 },
    "variantCount": { "type": "integer", "minimum": 0 },
    "familyCount": { "type": "integer", "minimum": 0 },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "provisional", "pending", "unsupported"],
      "properties": {
        "stable": { "type": "integer", "minimum": 0 },
        "provisional": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "status", "reasons", "taxonomyFamilies", "evidence", "unprobeable", "fixtureProfile"],
        "properties": {
          "family": { "type": "string" },
          "status": { "enum": ["stable", "provisional", "pending", "unsupported"] },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "taxonomyFamilies": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "detectors", "positiveContractTier", "hasProviderSource", "twinPairs", "twinFailures",
              "benignCases", "benignAxes", "benignAxisIds", "benignFalseAlarms", "metamorphicCriticalFailures", "mutationUnresolvedCritical", "differentialUnresolvedContractDisagreements"],
            "properties": {
              "family": { "type": "string" },
              "detectors": { "type": "array", "items": { "type": "string" } },
              "positiveContractTier": { "enum": ["T0", "T1", "T2", "T3", null] },
              "hasProviderSource": { "type": "boolean" },
              "twinPairs": { "type": "integer", "minimum": 0 },
              "twinFailures": { "type": "integer", "minimum": 0 },
              "benignCases": { "type": "integer", "minimum": 0 },
              "benignAxes": { "type": "integer", "minimum": 0 },
              "benignAxisIds": { "type": "array", "items": { "type": "string" } },
              "benignFalseAlarms": { "type": "integer", "minimum": 0 },
              "metamorphicCriticalFailures": { "type": "integer", "minimum": 0 },
              "mutationUnresolvedCritical": { "type": "integer", "minimum": 0 },
              "differentialUnresolvedContractDisagreements": { "type": "integer", "minimum": 0 },
              "unsupportedReason": { "type": "string" }
            }
          },
          "fixtureProfile": { "$ref": "#/definitions/fixtureProfile" },
          "unprobeable": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["reason", "observedAt"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "fixtureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profilesVersion", "claimed", "explicit", "target", "cellsMet", "cells", "debt"],
      "properties": {
        "profilesVersion": { "type": "integer", "minimum": 1 },
        "claimed": { "enum": ["arrival-provisional", "stable-documented", "stable-empirical", "context-constrained-empirical", null] },
        "explicit": { "type": "boolean" },
        "target": { "enum": ["arrival-provisional", "stable-documented", "stable-empirical", "context-constrained-empirical"] },
        "cellsMet": { "type": "array", "items": { "enum": ["arrival-provisional", "stable-documented", "stable-empirical", "context-constrained-empirical"] } },
        "cells": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalFixtures", "positiveCases", "benignControls", "twinPairs", "positiveContextAxes", "controlAxes", "confusionAxes", "positiveContextAxisIds", "controlAxisIds", "confusionAxisIds"],
          "properties": {
            "totalFixtures": { "type": "integer", "minimum": 0 },
            "positiveCases": { "type": "integer", "minimum": 0 },
            "benignControls": { "type": "integer", "minimum": 0 },
            "twinPairs": { "type": "integer", "minimum": 0 },
            "positiveContextAxes": { "type": "integer", "minimum": 0 },
            "controlAxes": { "type": "integer", "minimum": 0 },
            "confusionAxes": { "type": "integer", "minimum": 0 },
            "positiveContextAxisIds": { "type": "array", "items": { "type": "string" } },
            "controlAxisIds": { "type": "array", "items": { "type": "string" } },
            "confusionAxisIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "debt": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cell", "actual", "required", "shortfall"],
            "properties": {
              "cell": { "enum": ["totalFixtures", "positiveCases", "benignControls", "twinPairs", "positiveContextAxes", "controlAxes", "confusionAxes"] },
              "actual": { "type": "integer", "minimum": 0 },
              "required": { "type": "integer", "minimum": 1 },
              "shortfall": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
