{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:support-status-report:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "runId", "revision", "dirty", "criteriaSchemaVersion", "product", "scanners", "caseCount", "variantCount", "familyCount", "distribution", "stableDistribution", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "runId": { "type": "string" },
    "revision": { "type": "string" },
    "dirty": { "type": ["boolean", "null"] },
    "criteriaSchemaVersion": { "const": 1 },
    "product": {
      "type": ["object", "null"],
      "description": "Null when this run measured the pinned published package, the default. Populated when a candidate build substituted the redact-secret entry, naming the exact build the report describes so it can never be mistaken for one about a different build.",
      "additionalProperties": false,
      "required": ["sourceCommit", "packageName", "declaredVersion", "artifacts"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "packageName": { "type": "string", "minLength": 1 },
        "declaredVersion": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "sha256"],
            "properties": {
              "role": { "enum": ["package", "node", "wasm"] },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "scanners": { "type": "array", "items": { "type": "string" } },
    "caseCount": { "type": "integer", "minimum": 0 },
    "variantCount": { "type": "integer", "minimum": 0 },
    "familyCount": { "type": "integer", "minimum": 0 },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "provisional", "pending", "unsupported"],
      "properties": {
        "stable": { "type": "integer", "minimum": 0 },
        "provisional": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "stableDistribution": {
      "type": "object", "additionalProperties": false, "required": ["documented", "empirical"],
      "properties": { "documented": { "type": "integer", "minimum": 0 }, "empirical": { "type": "integer", "minimum": 0 } }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "status", "reasons", "qualificationProfile", "evidenceTier", "evidenceBasis", "taxonomyFamilies", "evidence", "unprobeable"],
        "properties": {
          "family": { "type": "string" },
          "status": { "enum": ["stable", "provisional", "pending", "unsupported"] },
          "qualificationProfile": { "enum": ["documented", "empirical", null] },
          "evidenceTier": { "enum": ["T0", "T1", "T2", "T3", null] },
          "evidenceBasis": { "enum": ["provider-documented", "independently-corroborated", "empirically-observed", "project-policy", "none"] },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "taxonomyFamilies": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "detectors", "positiveContractTier", "hasProviderSource", "evidenceBasis", "observationCount", "observationSubjects", "observationIssuanceDates", "corroborationClasses", "observationContradictions", "uncertainty", "supportedContexts", "empiricalMode", "supportsBareValues", "positiveCases", "positiveAxes", "controlAxes", "totalFixtures", "contextTwinPairs", "confusionAxes", "twinPairs", "twinFailures",
              "benignCases", "benignAxes", "benignAxisIds", "benignFalseAlarms", "metamorphicCriticalFailures", "mutationUnresolvedCritical", "differentialUnresolvedContractDisagreements"],
            "properties": {
              "family": { "type": "string" },
              "detectors": { "type": "array", "items": { "type": "string" } },
              "positiveContractTier": { "enum": ["T0", "T1", "T2", "T3", null] },
              "hasProviderSource": { "type": "boolean" },
              "evidenceBasis": { "enum": ["provider-documented", "independently-corroborated", "empirically-observed", "project-policy", "none"] },
              "observationCount": { "type": "integer", "minimum": 0 },
              "observationSubjects": { "type": "integer", "minimum": 0 },
              "observationIssuanceDates": { "type": "integer", "minimum": 0 },
              "corroborationClasses": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "observationContradictions": { "type": "integer", "minimum": 0 },
              "uncertainty": { "type": ["string", "null"] },
              "supportedContexts": { "type": "array", "items": { "type": "string" } },
              "empiricalMode": { "enum": ["shape", "context-constrained", null] },
              "supportsBareValues": { "type": "boolean" },
              "positiveCases": { "type": "integer", "minimum": 0 },
              "positiveAxes": { "type": "integer", "minimum": 0 },
              "controlAxes": { "type": "integer", "minimum": 0 },
              "totalFixtures": { "type": "integer", "minimum": 0 },
              "contextTwinPairs": { "type": "integer", "minimum": 0 },
              "confusionAxes": { "type": "integer", "minimum": 0 },
              "twinPairs": { "type": "integer", "minimum": 0 },
              "twinFailures": { "type": "integer", "minimum": 0 },
              "benignCases": { "type": "integer", "minimum": 0 },
              "benignAxes": { "type": "integer", "minimum": 0 },
              "benignAxisIds": { "type": "array", "items": { "type": "string" } },
              "benignFalseAlarms": { "type": "integer", "minimum": 0 },
              "metamorphicCriticalFailures": { "type": "integer", "minimum": 0 },
              "mutationUnresolvedCritical": { "type": "integer", "minimum": 0 },
              "differentialUnresolvedContractDisagreements": { "type": "integer", "minimum": 0 },
              "unsupportedReason": { "type": "string" }
            }
          },
          "unprobeable": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["reason", "observedAt"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    }
  }
}
